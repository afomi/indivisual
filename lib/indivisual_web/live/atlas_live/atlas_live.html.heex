<div
  id="atlas"
  class="pt-10 min-h-screen bg-slate-50 text-slate-900"
>
  <header
    class="border-b border-slate-200 bg-white px-4 py-3 sm:px-6"
  >
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"
        >
          Indivisual Atlas
        </p>
        <h1
          class="text-xl font-semibold tracking-tight"
        >
          A shared model of reality, read from an append-only event stream.
        </h1>
      </div>
      <dl
        id="atlas-status"
        class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600"
        aria-live="polite"
      >
        <div
          class="flex items-center gap-1"
        >
          <dt
            class="font-medium"
          >
            Data:
          </dt>
          <dd>
            <span
              class="rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 font-medium text-amber-800"
            >
              Demo fixture
            </span>
            No live blockchain or external API is connected.
          </dd>
        </div>
        <div
          class="flex items-center gap-1"
        >
          <dt
            class="font-medium"
          >
            Feed:
          </dt>
          <dd
            id="atlas-live-status"
          >
            <%= if @live? do %>
              live · {@live_updates} update(s) since load
            <% else %>
              connecting…
            <% end %>
          </dd>
        </div>
        <div
          class="flex items-center gap-1"
        >
          <dt
            class="font-medium"
          >
            Persistence:
          </dt>
          <dd
            id="atlas-persistence-status"
          >
            <%= case @feed_status.persistence do %>
              <% :ok -> %>
                Postgres · {@feed_status.persisted_count} appended event(s) kept across restarts
              <% {:error, _reason} -> %>
                <span
                  class="rounded border border-red-300 bg-red-50 px-1.5 py-0.5 font-medium text-red-800"
                >
                  unavailable
                </span>
                Appends are refused until the store is reachable.
            <% end %>
          </dd>
        </div>
        <div
          class="flex items-center gap-1"
        >
          <dt
            class="font-medium"
          >
            Events:
          </dt>
          <dd
            id="atlas-event-count"
          >
            {length(@events)}
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <div
    class="grid gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[17rem_minmax(0,1fr)_25rem]"
  >
    <%!-- ============ Region 1: projection rail ============ --%>
    <aside
      id="atlas-rail"
      class="space-y-6"
      aria-label="Projections, sources, and legend"
    >
      <section>
        <h2
          class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
        >
          Projection
        </h2>
        <ul
          id="atlas-projections"
          class="space-y-1"
          role="list"
        >
          <%= for def <- @projections do %>
            <li>
              <button
                type="button"
                phx-click="select_projection"
                phx-value-id={def.id}
                aria-pressed={to_string(def.id == @projection)}
                class={[
                  "w-full rounded-md border px-3 py-2 text-left motion-safe:transition-colors",
                  def.id == @projection && "border-blue-600 bg-blue-50",
                  def.id != @projection && "border-slate-200 bg-white hover:border-slate-400"
                ]}
              >
                <span
                  class="block text-sm font-medium"
                >
                  {def.name}
                </span>
                <span
                  class="block text-xs text-slate-600"
                >
                  {def.question}
                </span>
              </button>
            </li>
          <% end %>
        </ul>
        <p
          class="mt-2 text-xs text-slate-500"
        >
          A projection changes the read model, not the source events.
        </p>
      </section>

      <section>
        <div
          class="mb-2 flex items-baseline justify-between"
        >
          <h2
            class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
          >
            Sources
          </h2>
          <%= if @source_filter != [] do %>
            <button
              type="button"
              phx-click="clear_sources"
              class="text-xs text-blue-700 underline underline-offset-2"
            >
              Show all
            </button>
          <% end %>
        </div>
        <ul
          id="atlas-sources"
          class="space-y-1"
          role="list"
        >
          <%= for {id, source} <- Enum.sort_by(@sources, fn {_, s} -> s.title end) do %>
            <li>
              <button
                type="button"
                phx-click="toggle_source"
                phx-value-id={id}
                aria-pressed={to_string(id in @source_filter)}
                class={[
                  "w-full rounded-md border px-3 py-2 text-left text-xs motion-safe:transition-colors",
                  id in @source_filter && "border-blue-600 bg-blue-50",
                  id not in @source_filter && "border-slate-200 bg-white hover:border-slate-400"
                ]}
              >
                <span
                  class="block font-medium text-slate-900"
                >
                  {source.title}
                </span>
                <span
                  class="block text-slate-600"
                >
                  {source[:publisher] || "—"}
                </span>
                <span
                  class="mt-1 inline-flex items-center gap-1 text-[11px] text-slate-500"
                >
                  <span
                    class="rounded border border-slate-300 px-1"
                  >
                    {source.status}
                  </span>
                  <span
                    class="rounded border border-slate-300 px-1"
                  >
                    adapter: {source.adapter.status}
                  </span>
                </span>
              </button>
            </li>
          <% end %>
        </ul>
        <p
          class="mt-2 text-xs text-slate-500"
        >
          <%= if @source_filter == [] do %>
            All sources shown.
          <% else %>
            Filtering to {length(@source_filter)} source(s).
          <% end %>
        </p>
      </section>

      <section>
        <h2
          class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
        >
          Truth states
        </h2>
        <ul
          id="atlas-legend"
          class="space-y-1 text-xs"
          role="list"
        >
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("observed")]}
              aria-hidden="true"
            >
              {truth_glyph("observed")}
            </span>
            <span>
              <strong>observed</strong> — present in a primary record or seen directly
            </span>
          </li>
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("reported")]}
              aria-hidden="true"
            >
              {truth_glyph("reported")}
            </span>
            <span>
              <strong>reported</strong> — asserted by a source, not independently confirmed
            </span>
          </li>
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("proposed")]}
              aria-hidden="true"
            >
              {truth_glyph("proposed")}
            </span>
            <span>
              <strong>proposed</strong> — suggested or applied for, not yet adopted
            </span>
          </li>
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("adopted")]}
              aria-hidden="true"
            >
              {truth_glyph("adopted")}
            </span>
            <span>
              <strong>adopted</strong> — formally authorized
            </span>
          </li>
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("delivered")]}
              aria-hidden="true"
            >
              {truth_glyph("delivered")}
            </span>
            <span>
              <strong>delivered</strong> — built, operational, or completed
            </span>
          </li>
          <li
            class="flex items-center gap-2"
          >
            <span
              class={["w-5 rounded border text-center", truth_classes("superseded")]}
              aria-hidden="true"
            >
              {truth_glyph("superseded")}
            </span>
            <span>
              <strong>superseded</strong> — replaced by a later record
            </span>
          </li>
        </ul>
        <p
          class="mt-2 text-xs text-slate-500"
        >
          Annotations are their own events with their own author.
          They never overwrite a source event.
        </p>
      </section>
    </aside>

    <%!-- ============ Region 2: Atlas canvas ============ --%>
    <section
      id="atlas-canvas"
      class="rounded-lg border border-slate-200 bg-white p-3"
      aria-labelledby="atlas-canvas-title"
    >
      <div
        class="mb-2 flex flex-wrap items-baseline justify-between gap-2"
      >
        <h2
          id="atlas-canvas-title"
          class="text-sm font-semibold"
        >
          {Projections.get(@projection).name}
          <span
            class="font-normal text-slate-500"
          >
            · {map_size(@read_model.entities)} entities · {length(@read_model.relationships)} relationships
          </span>
        </h2>
        <%= if @entity do %>
          <p
            class="text-xs text-slate-600"
          >
            Focused on
            <strong>{entity_label(@read_model, @entity)}</strong>
            <button
              type="button"
              phx-click="clear_entity"
              class="ml-1 text-blue-700 underline underline-offset-2"
            >
              clear
            </button>
          </p>
        <% end %>
      </div>

      <%= if @projection == "entity" and is_nil(@read_model[:entity]) do %>
        <p
          id="atlas-canvas-empty"
          class="rounded border border-dashed border-slate-300 p-4 text-sm text-slate-600"
        >
          Pick an entity from the reader (or the list below) to see the events, relationships, and sources around it.
        </p>
      <% end %>

      <%= if @projection == "provenance" do %>
        <ul
          id="atlas-provenance-counts"
          class="mb-2 flex flex-wrap gap-2 text-xs"
          role="list"
        >
          <%= for %{truth_state: state, events: es} <- @read_model.groups do %>
            <li
              class={["rounded border px-2 py-0.5", truth_classes(state)]}
            >
              <span
                aria-hidden="true"
              >
                {truth_glyph(state)}
              </span>
              {state}: {length(es)}
            </li>
          <% end %>
        </ul>
      <% end %>

      <p
        class="sr-only"
      >
        The canvas draws {map_size(@read_model.entities)} entities on a ring and {length(@read_model.relationships)} relationships between them.
        The same information is available as lists in the reader.
      </p>

      <svg
        id="atlas-svg"
        viewBox="0 0 800 600"
        class="h-auto w-full max-w-full"
        role="img"
        aria-label={"Topology of #{map_size(@read_model.entities)} entities and #{length(@read_model.relationships)} relationships"}
        data-projection={@projection}
        data-selected={@selected && @selected.event_id}
      >
        <g
          id="atlas-svg-relationships"
        >
          <%= for rel <- @read_model.relationships do %>
            <% from = Map.get(@read_model.positions, rel.from) %>
            <% to = Map.get(@read_model.positions, rel.to) %>
            <%= if from && to do %>
              <line
                x1={from.x}
                y1={from.y}
                x2={to.x}
                y2={to.y}
                stroke={truth_stroke(rel.truth_state)}
                stroke-width={if @selected && rel.event_id == @selected.event_id, do: "4", else: "1.5"}
                stroke-dasharray={if rel.truth_state in ["proposed", "reported"], do: "6 4", else: nil}
                opacity={if @selected && rel.event_id == @selected.event_id, do: "1", else: "0.55"}
                data-event={rel.event_id}
                data-truth={rel.truth_state}
                class="motion-safe:transition-all"
              >
                <title>
                  {entity_label(@read_model, rel.from)} {rel.verb} {entity_label(@read_model, rel.to)} ({rel.truth_state})
                </title>
              </line>
            <% end %>
          <% end %>
        </g>
        <g
          id="atlas-svg-entities"
        >
          <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
            <% pos = Map.fetch!(@read_model.positions, ref) %>
            <% affected? = ref in @affected %>
            <% focused? = ref == @entity %>
            <g
              phx-click="focus_entity"
              phx-value-ref={ref}
              class="cursor-pointer"
              data-ref={ref}
              data-affected={to_string(affected?)}
              role="button"
              tabindex="-1"
            >
              <circle
                cx={pos.x}
                cy={pos.y}
                r={if affected? or focused?, do: 16, else: 10}
                fill={if affected?, do: "#1d4ed8", else: "#ffffff"}
                stroke={if focused?, do: "#b45309", else: "#1e293b"}
                stroke-width={if affected? or focused?, do: "3", else: "1.5"}
                class="motion-safe:transition-all"
              >
                <title>
                  {entity.label} ({entity.kind}) — {length(entity.event_ids)} event(s)
                </title>
              </circle>
              <text
                x={pos.x}
                y={pos.y + (if pos.y > 300, do: 30, else: -22)}
                text-anchor="middle"
                font-size="12"
                fill="#0f172a"
                font-weight={if affected?, do: "600", else: "400"}
              >
                {entity.label}
              </text>
              <%= if affected? do %>
                <text
                  x={pos.x}
                  y={pos.y + 4}
                  text-anchor="middle"
                  font-size="10"
                  fill="#ffffff"
                  aria-hidden="true"
                >
                  ●
                </text>
              <% end %>
            </g>
          <% end %>
        </g>
      </svg>

      <details
        class="mt-2 text-xs"
      >
        <summary
          class="cursor-pointer text-slate-600"
        >
          Entities in this projection ({map_size(@read_model.entities)})
        </summary>
        <ul
          id="atlas-entity-list"
          class="mt-1 grid gap-1 sm:grid-cols-2"
          role="list"
        >
          <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
            <li>
              <button
                type="button"
                phx-click="focus_entity"
                phx-value-ref={ref}
                class={[
                  "w-full rounded border px-2 py-1 text-left",
                  ref in @affected && "border-blue-600 bg-blue-50",
                  ref not in @affected && "border-slate-200"
                ]}
              >
                <span
                  class="font-medium"
                >
                  {entity.label}
                </span>
                <span
                  class="text-slate-500"
                >
                  · {entity.kind} · {length(entity.event_ids)} event(s)
                </span>
                <%= if ref in @affected do %>
                  <span
                    class="ml-1 rounded bg-blue-700 px-1 text-[10px] uppercase text-white"
                  >
                    affected
                  </span>
                <% end %>
              </button>
            </li>
          <% end %>
        </ul>
      </details>
    </section>

    <%!-- ============ Region 3: context reader + timeline ============ --%>
    <section
      id="atlas-reader"
      class="space-y-4"
      aria-label="Context reader and timeline"
    >
      <div
        class="rounded-lg border border-slate-200 bg-white p-3"
      >
        <div
          class="mb-2 flex items-center justify-between"
        >
          <h2
            class="text-sm font-semibold"
          >
            Timeline
          </h2>
          <div
            class="flex items-center gap-1"
          >
            <button
              type="button"
              phx-click="step"
              phx-value-dir="prev"
              class="rounded border border-slate-300 px-2 py-0.5 text-xs"
              aria-label="Previous event"
            >
              ← Prev
            </button>
            <button
              type="button"
              phx-click="step"
              phx-value-dir="next"
              class="rounded border border-slate-300 px-2 py-0.5 text-xs"
              aria-label="Next event"
            >
              Next →
            </button>
          </div>
        </div>
        <form
          phx-change="scrub"
          id="atlas-scrubber"
        >
          <label
            for="atlas-scrubber-input"
            class="sr-only"
          >
            Timeline scrubber
          </label>
          <input
            id="atlas-scrubber-input"
            type="range"
            name="index"
            min="0"
            max={max(length(@events) - 1, 0)}
            value={@selected_index || 0}
            class="w-full"
            aria-valuetext={@selected && "#{date(Event.effective_time(@selected))}: #{Event.title(@selected)}"}
          />
        </form>
        <p
          class="mt-1 text-xs text-slate-600"
        >
          <%= if @selected do %>
            {(@selected_index || 0) + 1} of {length(@events)} · {date(Event.effective_time(@selected))}
          <% else %>
            No events match the current filter.
          <% end %>
        </p>
      </div>

      <%= if @selected do %>
        <article
          id="atlas-selected"
          class="rounded-lg border border-slate-200 bg-white p-3"
          aria-live="polite"
        >
          <p
            class="text-xs uppercase tracking-[0.12em] text-slate-500"
          >
            <%= if Event.annotation?(@selected) do %>
              Annotation
            <% else %>
              Event
            <% end %>
            · {@selected.event_type}
          </p>
          <h2
            id="atlas-selected-title"
            class="mt-1 text-base font-semibold"
          >
            {Event.title(@selected)}
          </h2>
          <%= if @selected.payload["summary"] do %>
            <p
              class="mt-1 text-sm text-slate-700"
            >
              {@selected.payload["summary"]}
            </p>
          <% end %>
          <%= if @selected.payload["body"] do %>
            <p
              class="mt-1 text-sm text-slate-700"
            >
              {@selected.payload["body"]}
            </p>
          <% end %>

          <dl
            class="mt-3 grid grid-cols-[7rem_minmax(0,1fr)] gap-x-2 gap-y-1 text-xs"
          >
            <dt
              class="text-slate-500"
            >
              Truth state
            </dt>
            <dd
              id="atlas-selected-truth"
            >
              <span
                class={["inline-flex items-center gap-1 rounded border px-1.5", truth_classes(@selected.truth_state)]}
              >
                <span
                  aria-hidden="true"
                >
                  {truth_glyph(@selected.truth_state)}
                </span>
                {@selected.truth_state}
              </span>
            </dd>
            <dt
              class="text-slate-500"
            >
              Occurred
            </dt>
            <dd>
              {stamp(@selected.occurred_at)}
            </dd>
            <dt
              class="text-slate-500"
            >
              Observed
            </dt>
            <dd>
              {stamp(@selected.observed_at)}
            </dd>
            <dt
              class="text-slate-500"
            >
              Source
            </dt>
            <dd
              id="atlas-selected-source"
            >
              <%= if url = source_url(@sources, @selected.source_id) do %>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener"
                  class="text-blue-700 underline underline-offset-2"
                >
                  {source_title(@sources, @selected.source_id)}
                </a>
              <% else %>
                {source_title(@sources, @selected.source_id)}
              <% end %>
              <span
                class="ml-1 rounded border border-slate-300 px-1 text-[11px] text-slate-600"
              >
                {source_status(@sources, @selected.source_id)}
              </span>
            </dd>
            <dt
              class="text-slate-500"
            >
              Stream
            </dt>
            <dd>
              {@selected.stream_id} · seq {sequence(@selected.sequence)}
            </dd>
            <%= if @selected.actor_ref do %>
              <dt
                class="text-slate-500"
              >
                Actor
              </dt>
              <dd>
                <button
                  type="button"
                  phx-click="focus_entity"
                  phx-value-ref={@selected.actor_ref}
                  class="text-blue-700 underline underline-offset-2"
                >
                  {entity_label(@read_model, @selected.actor_ref)}
                </button>
              </dd>
            <% end %>
            <dt
              class="text-slate-500"
            >
              Affects
            </dt>
            <dd
              id="atlas-selected-affects"
            >
              <ul
                class="flex flex-wrap gap-1"
                role="list"
              >
                <%= for ref <- @selected.subject_refs do %>
                  <li>
                    <button
                      type="button"
                      phx-click="focus_entity"
                      phx-value-ref={ref}
                      class="rounded border border-blue-300 bg-blue-50 px-1.5 text-blue-800"
                    >
                      {entity_label(@read_model, ref)}
                    </button>
                  </li>
                <% end %>
              </ul>
            </dd>
            <dt
              class="text-slate-500"
            >
              Provenance
            </dt>
            <dd
              id="atlas-selected-provenance"
            >
              <ul
                class="space-y-0.5"
                role="list"
              >
                <%= for {k, v} <- Enum.sort(@selected.provenance) do %>
                  <li
                    class="break-all"
                  >
                    <span
                      class="text-slate-500"
                    >
                      {k}:
                    </span>
                    <%= if is_binary(v) and String.starts_with?(v, "http") do %>
                      <a
                        href={v}
                        target="_blank"
                        rel="noopener"
                        class="text-blue-700 underline underline-offset-2"
                      >
                        {v}
                      </a>
                    <% else %>
                      {to_string(v)}
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </dd>
            <dt
              class="text-slate-500"
            >
              Event id
            </dt>
            <dd
              class="break-all font-mono text-[11px]"
            >
              {@selected.event_id}
            </dd>
          </dl>

          <%= if @selected_relationships != [] or @entity_relationships != [] do %>
            <h3
              class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
            >
              Relationships
            </h3>
            <ul
              id="atlas-selected-relationships"
              class="mt-1 space-y-1 text-xs"
              role="list"
            >
              <%= for rel <- Enum.uniq(@selected_relationships ++ @entity_relationships) do %>
                <li
                  class={[
                    "rounded border px-2 py-1",
                    rel.event_id == @selected.event_id && "border-blue-600 bg-blue-50",
                    rel.event_id != @selected.event_id && "border-slate-200"
                  ]}
                >
                  <strong>{entity_label(@read_model, rel.from)}</strong>
                  <em>{rel.verb}</em>
                  <strong>{entity_label(@read_model, rel.to)}</strong>
                  <span
                    class={["ml-1 inline-flex items-center gap-1 rounded border px-1", truth_classes(rel.truth_state)]}
                  >
                    <span
                      aria-hidden="true"
                    >
                      {truth_glyph(rel.truth_state)}
                    </span>
                    {rel.truth_state}
                  </span>
                  <span
                    class="text-slate-500"
                  >
                    · {source_title(@sources, rel.source_id)} · {date(rel.occurred_at)}
                  </span>
                  <%= if rel.event_id != @selected.event_id do %>
                    <button
                      type="button"
                      phx-click="select_event"
                      phx-value-id={rel.event_id}
                      class="ml-1 text-blue-700 underline underline-offset-2"
                    >
                      open
                    </button>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <%= if @annotations_for_selected != [] do %>
            <h3
              class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
            >
              Annotations on this event
            </h3>
            <ul
              id="atlas-selected-annotations"
              class="mt-1 space-y-1 text-xs"
              role="list"
            >
              <%= for note <- @annotations_for_selected do %>
                <li
                  class="rounded border border-slate-200 px-2 py-1"
                >
                  <span
                    class="rounded border border-slate-300 px-1"
                  >
                    {note.payload["kind"]}
                  </span>
                  {note.payload["body"]}
                  <span
                    class="text-slate-500"
                  >
                    · {note.provenance["author"]} · {stamp(note.observed_at)}
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>

          <%= unless Event.annotation?(@selected) do %>
            <.form
              for={@annotation_form}
              id="atlas-annotation-form"
              phx-change="validate_annotation"
              phx-submit="annotate"
              class="mt-3 space-y-2 border-t border-slate-200 pt-3"
            >
              <h3
                class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500"
              >
                Annotate
              </h3>
              <%= for {field, message} <- @annotation_errors do %>
                <p
                  class="text-xs text-red-700"
                  role="alert"
                >
                  {field} {message}
                </p>
              <% end %>
              <div
                class="grid grid-cols-2 gap-2"
              >
                <label
                  class="text-xs"
                >
                  Kind
                  <select
                    name={@annotation_form[:kind].name}
                    class="mt-0.5 w-full rounded border-slate-300 text-xs"
                  >
                    <%= for kind <- annotation_kinds() do %>
                      <option
                        value={kind}
                        selected={@annotation_form[:kind].value == kind}
                      >
                        {kind}
                      </option>
                    <% end %>
                  </select>
                </label>
                <label
                  class="text-xs"
                >
                  Author
                  <input
                    type="text"
                    name={@annotation_form[:author].name}
                    value={@annotation_form[:author].value}
                    placeholder="your name or handle"
                    class="mt-0.5 w-full rounded border-slate-300 text-xs"
                  />
                </label>
              </div>
              <label
                class="block text-xs"
              >
                Note
                <textarea
                  name={@annotation_form[:body].name}
                  rows="2"
                  placeholder="Specific and checkable: what did you observe, question, or correct?"
                  class="mt-0.5 w-full rounded border-slate-300 text-xs"
                >{@annotation_form[:body].value}</textarea>
              </label>
              <button
                type="submit"
                class="rounded bg-slate-900 px-3 py-1 text-xs font-medium text-white"
              >
                Record annotation
              </button>
              <p
                class="text-[11px] text-slate-500"
              >
                Recorded as a separate event in this session's in-memory feed with your name as author.
              </p>
            </.form>
          <% end %>

          <p
            class="mt-3 text-[11px] text-slate-500"
          >
            Share this context:
            <.link
              id="atlas-share-link"
              patch={@share_path}
              class="break-all font-mono text-blue-700 underline underline-offset-2"
            >
              {@share_path}
            </.link>
          </p>
        </article>
      <% end %>

      <div
        class="rounded-lg border border-slate-200 bg-white p-3"
      >
        <h2
          class="mb-2 text-sm font-semibold"
        >
          Activity
        </h2>
        <ol
          id="atlas-activity"
          class="space-y-1"
          aria-label="Activity, in source order"
        >
          <%= for {event, i} <- Enum.with_index(@events) do %>
            <li
              id={"atlas-activity-#{i}"}
            >
              <button
                type="button"
                phx-click="select_event"
                phx-value-id={event.event_id}
                aria-current={if @selected && event.event_id == @selected.event_id, do: "true", else: nil}
                class={[
                  "w-full rounded-md border px-2 py-1.5 text-left text-xs motion-safe:transition-colors",
                  @selected && event.event_id == @selected.event_id && "border-blue-600 bg-blue-50",
                  !(@selected && event.event_id == @selected.event_id) && "border-slate-200 bg-white hover:border-slate-400",
                  @selected_index && i > @selected_index && "opacity-60"
                ]}
              >
                <span
                  class="flex items-center justify-between gap-2"
                >
                  <time
                    datetime={stamp(Event.effective_time(event))}
                    class="font-mono text-[11px] text-slate-500"
                  >
                    {date(Event.effective_time(event))}
                  </time>
                  <span
                    class={["inline-flex items-center gap-1 rounded border px-1 text-[10px]", truth_classes(event.truth_state)]}
                  >
                    <span
                      aria-hidden="true"
                    >
                      {truth_glyph(event.truth_state)}
                    </span>
                    {event.truth_state}
                  </span>
                </span>
                <span
                  class="mt-0.5 block font-medium text-slate-900"
                >
                  <%= if Event.annotation?(event) do %>
                    <span
                      class="rounded border border-slate-300 px-1 text-[10px] uppercase"
                    >
                      annotation
                    </span>
                  <% end %>
                  {Event.title(event)}
                </span>
                <span
                  class="block text-slate-500"
                >
                  {source_title(@sources, event.source_id)} · affects {length(Event.affected_refs(event))}
                </span>
              </button>
            </li>
          <% end %>
        </ol>
      </div>
    </section>
  </div>
</div>
