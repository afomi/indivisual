<%!-- NOTE: the interior of this template still carries the Tailwind utility
classes it was written with in adaptics. The surrounding chrome now follows the
Swiss/minimal system in assets/css/app.css; converting the remaining ~140 class
attributes is a separate pass, tracked in PLAN.md. It is deliberately NOT done
inline here — the page works, and a blind find-and-replace across 1073 lines
would be a good way to break it silently. --%>
<Layouts.app
  flash={@flash}
  current_scope={assigns[:current_scope]}
  full={true}
>
  <div
    id="atlas"
    class="atlas"
  >
    <header class="border-b border-slate-200 bg-white px-4 py-3 sm:px-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <h1 class="text-xl font-semibold tracking-tight">
            A shared model of reality, read from an append-only event stream.
          </h1>
        </div>
        <dl
          id="atlas-status"
          class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600"
          aria-live="polite"
        >
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Data:
            </dt>
            <dd>
              <span class="rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 font-medium text-amber-800">
                Demo fixture
              </span>
              No live blockchain or external API is connected.
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Feed:
            </dt>
            <dd id="atlas-live-status">
              <%= if @live? do %>
                live · {@live_updates} update(s) since load
              <% else %>
                connecting…
              <% end %>
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Persistence:
            </dt>
            <dd id="atlas-persistence-status">
              <%= case @feed_status.persistence do %>
                <% :ok -> %>
                  Postgres · {@feed_status.persisted_count} appended event(s) kept across restarts
                <% {:error, _reason} -> %>
                  <span class="rounded border border-red-300 bg-red-50 px-1.5 py-0.5 font-medium text-red-800">
                    unavailable
                  </span>
                  Appends are refused until the store is reachable.
              <% end %>
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Events:
            </dt>
            <dd id="atlas-event-count">
              {length(@events)}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <%!-- ============ Projection selector ============ --%>
    <%!-- Four mutually exclusive options, so a radio group: the browser gives
    arrow-key navigation and a single-selection contract for free, and all four
    stay visible rather than hiding behind a menu. --%>
    <nav
      id="atlas-projection-nav"
      class="atlas-projnav"
      aria-label="Projection"
    >
      <form
        id="atlas-projections"
        phx-change="select_projection"
        class="atlas-projnav__row"
        role="radiogroup"
        aria-label="Projection"
      >
        <%= for def <- @projections do %>
          <label class={["atlas-projnav__option", def.id == @projection && "is-active"]}>
            <input
              type="radio"
              name="projection"
              value={def.id}
              checked={def.id == @projection}
              class="sr-only"
            />
            <span class="atlas-projnav__name">
              {def.name}
            </span>
            <span class="atlas-projnav__question">
              {def.question}
            </span>
          </label>
        <% end %>
      </form>

      <%!-- Reference material, not a control: consulted once, then in the way. --%>
      <button
        type="button"
        id="atlas-legend-open"
        phx-click="show_legend"
        class="atlas-legend-button"
        aria-haspopup="dialog"
      >
        <span aria-hidden="true">ⓘ</span> Truth states
      </button>
    </nav>

    <%!-- ============ Source selector ============ --%>
    <%!-- Sources get the same treatment as projections: a full-width row of
    options above the timeline, each naming what it is and who publishes it.
    Unlike projections these are NOT mutually exclusive — any combination of
    sources can be shown — so they are toggle buttons with aria-pressed rather
    than a radio group. Same visual grammar, honest semantics. --%>
    <nav
      id="atlas-source-nav"
      class="atlas-projnav"
      aria-label="Sources"
    >
      <div class="atlas-projnav__row atlas-sourcenav__row">
        <%= for {id, source} <- Enum.sort_by(@sources, fn {_, s} -> s.title end) do %>
          <button
            type="button"
            phx-click="toggle_source"
            phx-value-id={id}
            aria-pressed={to_string(id in @source_filter)}
            class={[
              "atlas-projnav__option atlas-sourcenav__option",
              id in @source_filter && "is-active"
            ]}
          >
            <span class="atlas-projnav__name">
              {source.title}
            </span>
            <span class="atlas-projnav__question">
              {source[:publisher] || "—"}
            </span>
            <span class="atlas-sourcenav__meta">
              {source.status} · adapter: {source.adapter.status}
            </span>
          </button>
        <% end %>
      </div>

      <p class="atlas-sourcenav__readout">
        <%= if @source_filter == [] do %>
          All sources shown.
        <% else %>
          Filtering to {length(@source_filter)} of {map_size(@sources)} sources.
          <button
            type="button"
            phx-click="clear_sources"
            class="atlas-sourcenav__clear"
          >
            Show all
          </button>
        <% end %>
      </p>
    </nav>

    <%!-- ============ Timeline: full-width, above the columns ============ --%>
    <%!-- Its own element at 100% width, holding exactly two controls: an "all
    events" toggle, and a range with two dials. Either bound may be left open,
    so the range reads "from the beginning" or "to the present" rather than
    forcing a window. --%>
    <section
      id="atlas-timeline"
      class="atlas-timeline"
      aria-label="Timeline"
    >
      <div class="atlas-timeline__bar">
        <h2 class="atlas-timeline__title">
          Timeline
        </h2>

        <label
          id="atlas-timeline-all"
          class="atlas-timeline__toggle"
        >
          <input
            type="checkbox"
            phx-click="toggle_all"
            checked={@show_all}
            aria-describedby="atlas-timeline-readout"
          />
          <span>All events</span>
        </label>

        <p
          id="atlas-timeline-readout"
          class="atlas-timeline__readout"
        >
          <%= if @all_events == [] do %>
            No events.
          <% else %>
            <%= if @show_all do %>
              Showing all {length(@all_events)}
            <% else %>
              Showing {length(@events)} of {length(@all_events)}
              <%= if @range_from || @range_to do %>
                · {range_label(@all_events, @range_from, @range_to)}
              <% else %>
                · full range
              <% end %>
            <% end %>
          <% end %>
        </p>

        <div class="atlas-timeline__actions">
          <button
            type="button"
            phx-click="step"
            phx-value-dir="prev"
            aria-label="Previous event"
          >
            ← Prev
          </button>
          <button
            type="button"
            phx-click="step"
            phx-value-dir="next"
            aria-label="Next event"
          >
            Next →
          </button>
          <%= if @range_from || @range_to do %>
            <button
              type="button"
              phx-click="clear_range"
              id="atlas-timeline-clear"
            >
              Clear range
            </button>
          <% end %>
        </div>
      </div>

      <form
        phx-change="range"
        id="atlas-timeline-range"
        class={["atlas-timeline__range", @show_all && "is-disabled"]}
      >
        <label
          for="atlas-timeline-from"
          class="sr-only"
        >
          Range start
        </label>
        <input
          id="atlas-timeline-from"
          type="range"
          name="from"
          min="0"
          max={max(length(@all_events) - 1, 0)}
          value={@range_from || 0}
          disabled={@show_all}
          aria-valuetext={index_label(@all_events, @range_from || 0)}
        />
        <label
          for="atlas-timeline-to"
          class="sr-only"
        >
          Range end
        </label>
        <input
          id="atlas-timeline-to"
          type="range"
          name="to"
          min="0"
          max={max(length(@all_events) - 1, 0)}
          value={@range_to || max(length(@all_events) - 1, 0)}
          disabled={@show_all}
          aria-valuetext={index_label(@all_events, @range_to || max(length(@all_events) - 1, 0))}
        />
      </form>

      <%!-- Scrub within the selected range. --%>
      <form
        phx-change="scrub"
        id="atlas-scrubber"
        class="atlas-timeline__scrub"
      >
        <label
          for="atlas-scrubber-input"
          class="sr-only"
        >
          Timeline scrubber
        </label>
        <input
          id="atlas-scrubber-input"
          type="range"
          name="index"
          min="0"
          max={max(length(@events) - 1, 0)}
          value={@selected_index || 0}
          aria-valuetext={
            @selected && "#{date(Event.effective_time(@selected))}: #{Event.title(@selected)}"
          }
        />
        <p class="atlas-timeline__position">
          <%= if @selected do %>
            {(@selected_index || 0) + 1} of {length(@events)} · {date(
              Event.effective_time(@selected)
            )}
          <% else %>
            No events match the current filter.
          <% end %>
        </p>
      </form>
    </section>

    <div class="grid gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[15rem_22rem_minmax(0,1fr)] lg:items-start">
      <%!-- ============ Column 1: sources, legend, and the event log ============ --%>
      <div class="space-y-6">
        <%!-- The legend that lived here now opens from the nav's info button;
        this keeps the column's landmark so ordering stays stable. --%>
        <aside
          id="atlas-rail"
          class="sr-only"
          aria-label="Legend"
        >
          Truth states are documented in the legend dialog.
        </aside>
        <div>
          <h2 class="mb-2 text-sm font-semibold">
            Activity
          </h2>
          <ol
            id="atlas-activity"
            class="space-y-1"
            aria-label="Activity, in source order"
          >
            <%= for {event, i} <- Enum.with_index(@events) do %>
              <li id={"atlas-activity-#{i}"}>
                <button
                  type="button"
                  phx-click="select_event"
                  phx-value-id={event.event_id}
                  aria-current={
                    if @selected && event.event_id == @selected.event_id, do: "true", else: nil
                  }
                  class={[
                    "atlas-activity__item",
                    @selected && event.event_id == @selected.event_id && "is-selected",
                    @selected_index && i > @selected_index && "is-future"
                  ]}
                >
                  <span class="flex items-center justify-between gap-2">
                    <time
                      datetime={stamp(Event.effective_time(event))}
                      class="font-mono text-[11px] text-slate-500"
                    >
                      {date(Event.effective_time(event))}
                    </time>
                    <span class={[
                      "inline-flex items-center gap-1 rounded border px-1 text-[10px]",
                      truth_classes(event.truth_state)
                    ]}>
                      <span aria-hidden="true">
                        {truth_glyph(event.truth_state)}
                      </span>
                      {event.truth_state}
                    </span>
                  </span>
                  <span class="mt-0.5 block font-medium text-slate-900">
                    <%= if Event.annotation?(event) do %>
                      <span class="rounded border border-slate-300 px-1 text-[10px] uppercase">
                        annotation
                      </span>
                    <% end %>
                    {Event.title(event)}
                  </span>
                  <span class="block text-slate-500">
                    {source_title(@sources, event.source_id)} · affects {length(
                      Event.affected_refs(event)
                    )}
                  </span>
                </button>
              </li>
            <% end %>
          </ol>
        </div>
      </div>

      <%!-- ============ Column 2: entity / selected-event detail ============ --%>
      <section
        id="atlas-reader"
        class="space-y-4"
        aria-label="Context reader"
      >
        <%= if @selected do %>
          <article
            id="atlas-selected"
            class="rounded-lg border border-slate-200 bg-white p-3"
            aria-live="polite"
          >
            <p class="text-xs uppercase tracking-[0.12em] text-slate-500">
              <%= if Event.annotation?(@selected) do %>
                Annotation
              <% else %>
                Event
              <% end %>
              · {@selected.event_type}
            </p>
            <h2
              id="atlas-selected-title"
              class="mt-1 text-base font-semibold"
            >
              {Event.title(@selected)}
            </h2>
            <%= if @selected.payload["summary"] do %>
              <p class="mt-1 text-sm text-slate-700">
                {@selected.payload["summary"]}
              </p>
            <% end %>
            <%= if @selected.payload["body"] do %>
              <p class="mt-1 text-sm text-slate-700">
                {@selected.payload["body"]}
              </p>
            <% end %>

            <dl class="mt-3 grid grid-cols-[7rem_minmax(0,1fr)] gap-x-2 gap-y-1 text-xs">
              <dt class="text-slate-500">
                Truth state
              </dt>
              <dd id="atlas-selected-truth">
                <span class={[
                  "inline-flex items-center gap-1 rounded border px-1.5",
                  truth_classes(@selected.truth_state)
                ]}>
                  <span aria-hidden="true">
                    {truth_glyph(@selected.truth_state)}
                  </span>
                  {@selected.truth_state}
                </span>
              </dd>
              <dt class="text-slate-500">
                Occurred
              </dt>
              <dd>
                {stamp(@selected.occurred_at)}
              </dd>
              <dt class="text-slate-500">
                Observed
              </dt>
              <dd>
                {stamp(@selected.observed_at)}
              </dd>
              <dt class="text-slate-500">
                Source
              </dt>
              <dd id="atlas-selected-source">
                <%= if url = source_url(@sources, @selected.source_id) do %>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener"
                    class="text-blue-700 underline underline-offset-2"
                  >
                    {source_title(@sources, @selected.source_id)}
                  </a>
                <% else %>
                  {source_title(@sources, @selected.source_id)}
                <% end %>
                <span class="ml-1 rounded border border-slate-300 px-1 text-[11px] text-slate-600">
                  {source_status(@sources, @selected.source_id)}
                </span>
              </dd>
              <dt class="text-slate-500">
                Stream
              </dt>
              <dd>
                {@selected.stream_id} · seq {sequence(@selected.sequence)}
              </dd>
              <%= if @selected.actor_ref do %>
                <dt class="text-slate-500">
                  Actor
                </dt>
                <dd>
                  <button
                    type="button"
                    phx-click="focus_entity"
                    phx-value-ref={@selected.actor_ref}
                    class="text-blue-700 underline underline-offset-2"
                  >
                    {entity_label(@read_model, @selected.actor_ref)}
                  </button>
                </dd>
              <% end %>
              <dt class="text-slate-500">
                Affects
              </dt>
              <dd id="atlas-selected-affects">
                <ul
                  class="flex flex-wrap gap-1"
                  role="list"
                >
                  <%= for ref <- @selected.subject_refs do %>
                    <li>
                      <button
                        type="button"
                        phx-click="focus_entity"
                        phx-value-ref={ref}
                        class="rounded border border-blue-300 bg-blue-50 px-1.5 text-blue-800"
                      >
                        {entity_label(@read_model, ref)}
                      </button>
                    </li>
                  <% end %>
                </ul>
              </dd>
              <dt class="text-slate-500">
                Provenance
              </dt>
              <dd id="atlas-selected-provenance">
                <ul
                  class="space-y-0.5"
                  role="list"
                >
                  <%= for {k, v} <- Enum.sort(@selected.provenance) do %>
                    <li class="break-all">
                      <span class="text-slate-500">
                        {k}:
                      </span>
                      <%= if is_binary(v) and String.starts_with?(v, "http") do %>
                        <a
                          href={v}
                          target="_blank"
                          rel="noopener"
                          class="text-blue-700 underline underline-offset-2"
                        >
                          {v}
                        </a>
                      <% else %>
                        {to_string(v)}
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </dd>
              <dt class="text-slate-500">
                Event id
              </dt>
              <dd class="break-all font-mono text-[11px]">
                {@selected.event_id}
              </dd>
            </dl>

            <%= if @selected_relationships != [] or @entity_relationships != [] do %>
              <h3 class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                Relationships
              </h3>
              <ul
                id="atlas-selected-relationships"
                class="mt-1 space-y-1 text-xs"
                role="list"
              >
                <%= for rel <- Enum.uniq(@selected_relationships ++ @entity_relationships) do %>
                  <li class={[
                    "rounded border px-2 py-1",
                    rel.event_id == @selected.event_id && "border-blue-600 bg-blue-50",
                    rel.event_id != @selected.event_id && "border-slate-200"
                  ]}>
                    <strong>{entity_label(@read_model, rel.from)}</strong>
                    <em>{rel.verb}</em>
                    <strong>{entity_label(@read_model, rel.to)}</strong>
                    <span class={[
                      "ml-1 inline-flex items-center gap-1 rounded border px-1",
                      truth_classes(rel.truth_state)
                    ]}>
                      <span aria-hidden="true">
                        {truth_glyph(rel.truth_state)}
                      </span>
                      {rel.truth_state}
                    </span>
                    <span class="text-slate-500">
                      · {source_title(@sources, rel.source_id)} · {date(rel.occurred_at)}
                    </span>
                    <%= if rel.event_id != @selected.event_id do %>
                      <button
                        type="button"
                        phx-click="select_event"
                        phx-value-id={rel.event_id}
                        class="ml-1 text-blue-700 underline underline-offset-2"
                      >
                        open
                      </button>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <%= if @annotations_for_selected != [] do %>
              <h3 class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                Annotations on this event
              </h3>
              <ul
                id="atlas-selected-annotations"
                class="mt-1 space-y-1 text-xs"
                role="list"
              >
                <%= for note <- @annotations_for_selected do %>
                  <li class="rounded border border-slate-200 px-2 py-1">
                    <span class="rounded border border-slate-300 px-1">
                      {note.payload["kind"]}
                    </span>
                    {note.payload["body"]}
                    <span class="text-slate-500">
                      · {note.provenance["author"]} · {stamp(note.observed_at)}
                    </span>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <%= unless Event.annotation?(@selected) do %>
              <.form
                for={@annotation_form}
                id="atlas-annotation-form"
                phx-change="validate_annotation"
                phx-submit="annotate"
                class="mt-3 space-y-2 border-t border-slate-200 pt-3"
              >
                <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                  Annotate
                </h3>
                <%= for {field, message} <- @annotation_errors do %>
                  <p
                    class="text-xs text-red-700"
                    role="alert"
                  >
                    {field} {message}
                  </p>
                <% end %>
                <div class="grid grid-cols-2 gap-2">
                  <label class="text-xs">
                    Kind
                    <select
                      name={@annotation_form[:kind].name}
                      class="mt-0.5 w-full rounded border-slate-300 text-xs"
                    >
                      <%= for kind <- annotation_kinds() do %>
                        <option
                          value={kind}
                          selected={@annotation_form[:kind].value == kind}
                        >
                          {kind}
                        </option>
                      <% end %>
                    </select>
                  </label>
                  <label class="text-xs">
                    Author
                    <input
                      type="text"
                      name={@annotation_form[:author].name}
                      value={@annotation_form[:author].value}
                      placeholder="your name or handle"
                      class="mt-0.5 w-full rounded border-slate-300 text-xs"
                    />
                  </label>
                </div>
                <label class="block text-xs">
                  Note <textarea
                    name={@annotation_form[:body].name}
                    rows="2"
                    placeholder="Specific and checkable: what did you observe, question, or correct?"
                    class="mt-0.5 w-full rounded border-slate-300 text-xs"
                  >{@annotation_form[:body].value}</textarea>
                </label>
                <button
                  type="submit"
                  class="rounded bg-slate-900 px-3 py-1 text-xs font-medium text-white"
                >
                  Record annotation
                </button>
                <p class="text-[11px] text-slate-500">
                  Recorded as a separate event in this session's in-memory feed with your name as author.
                </p>
              </.form>
            <% end %>

            <p class="mt-3 text-[11px] text-slate-500">
              Share this context:
              <.link
                id="atlas-share-link"
                patch={@share_path}
                class="break-all font-mono text-blue-700 underline underline-offset-2"
              >
                {@share_path}
              </.link>
            </p>
          </article>
        <% end %>
      </section>

      <%!-- ============ Column 3: the canvas, filling remaining width ============ --%>
      <section
        id="atlas-canvas"
        class="rounded-lg border border-slate-200 bg-white p-3 lg:sticky lg:top-4"
        aria-labelledby="atlas-canvas-title"
      >
        <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
          <h2
            id="atlas-canvas-title"
            class="text-sm font-semibold"
          >
            {Projections.get(@projection).name}
            <span class="font-normal text-slate-500">
              · {map_size(@read_model.entities)} entities · {length(@read_model.relationships)} relationships
            </span>
          </h2>
          <%= if @entity do %>
            <p class="text-xs text-slate-600">
              Focused on <strong>{entity_label(@read_model, @entity)}</strong>
              <button
                type="button"
                phx-click="clear_entity"
                class="ml-1 text-blue-700 underline underline-offset-2"
              >
                clear
              </button>
            </p>
          <% end %>
        </div>

        <%= if @projection == "entity" and is_nil(@read_model[:entity]) do %>
          <p
            id="atlas-canvas-empty"
            class="rounded border border-dashed border-slate-300 p-4 text-sm text-slate-600"
          >
            Pick an entity from the reader (or the list below) to see the events, relationships, and sources around it.
          </p>
        <% end %>

        <%= if @projection == "provenance" do %>
          <ul
            id="atlas-provenance-counts"
            class="mb-2 flex flex-wrap gap-2 text-xs"
            role="list"
          >
            <%= for %{truth_state: state, events: es} <- @read_model.groups do %>
              <li class={["rounded border px-2 py-0.5", truth_classes(state)]}>
                <span aria-hidden="true">
                  {truth_glyph(state)}
                </span>
                {state}: {length(es)}
              </li>
            <% end %>
          </ul>
        <% end %>

        <p class="sr-only">
          The canvas draws {map_size(@read_model.entities)} entities on a ring and {length(
            @read_model.relationships
          )} relationships between them.
          The same information is available as lists in the reader.
        </p>

        <svg
          id="atlas-svg"
          viewBox="0 0 800 600"
          class="h-auto w-full max-w-full"
          role="img"
          aria-label={"Topology of #{map_size(@read_model.entities)} entities and #{length(@read_model.relationships)} relationships"}
          data-projection={@projection}
          data-selected={@selected && @selected.event_id}
        >
          <g id="atlas-svg-relationships">
            <%= for rel <- @read_model.relationships do %>
              <% from = Map.get(@read_model.positions, rel.from) %>
              <% to = Map.get(@read_model.positions, rel.to) %>
              <%= if from && to do %>
                <line
                  x1={from.x}
                  y1={from.y}
                  x2={to.x}
                  y2={to.y}
                  stroke={truth_stroke(rel.truth_state)}
                  stroke-width={
                    if @selected && rel.event_id == @selected.event_id, do: "4", else: "1.5"
                  }
                  stroke-dasharray={
                    if rel.truth_state in ["proposed", "reported"], do: "6 4", else: nil
                  }
                  opacity={
                    if @selected && rel.event_id == @selected.event_id, do: "1", else: "0.55"
                  }
                  data-event={rel.event_id}
                  data-truth={rel.truth_state}
                  class="motion-safe:transition-all"
                >
                  <title>
                    {entity_label(@read_model, rel.from)} {rel.verb} {entity_label(
                      @read_model,
                      rel.to
                    )} ({rel.truth_state})
                  </title>
                </line>
              <% end %>
            <% end %>
          </g>
          <g id="atlas-svg-entities">
            <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
              <% pos = Map.fetch!(@read_model.positions, ref) %>
              <% affected? = ref in @affected %>
              <% focused? = ref == @entity %>
              <g
                phx-click="focus_entity"
                phx-value-ref={ref}
                class="cursor-pointer"
                data-ref={ref}
                data-affected={to_string(affected?)}
                role="button"
                tabindex="-1"
              >
                <circle
                  cx={pos.x}
                  cy={pos.y}
                  r={if affected? or focused?, do: 16, else: 10}
                  fill={if affected?, do: "#1d4ed8", else: "#ffffff"}
                  stroke={if focused?, do: "#b45309", else: "#1e293b"}
                  stroke-width={if affected? or focused?, do: "3", else: "1.5"}
                  class="motion-safe:transition-all"
                >
                  <title>
                    {entity.label} ({entity.kind}) — {length(entity.event_ids)} event(s)
                  </title>
                </circle>
                <text
                  x={pos.x}
                  y={pos.y + if pos.y > 300, do: 30, else: -22}
                  text-anchor="middle"
                  font-size="12"
                  fill="#0f172a"
                  font-weight={if affected?, do: "600", else: "400"}
                >
                  {entity.label}
                </text>
                <%= if affected? do %>
                  <text
                    x={pos.x}
                    y={pos.y + 4}
                    text-anchor="middle"
                    font-size="10"
                    fill="#ffffff"
                    aria-hidden="true"
                  >
                    ●
                  </text>
                <% end %>
              </g>
            <% end %>
          </g>
        </svg>

        <details class="mt-2 text-xs">
          <summary class="cursor-pointer text-slate-600">
            Entities in this projection ({map_size(@read_model.entities)})
          </summary>
          <ul
            id="atlas-entity-list"
            class="mt-1 grid gap-1 sm:grid-cols-2"
            role="list"
          >
            <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
              <li>
                <button
                  type="button"
                  phx-click="focus_entity"
                  phx-value-ref={ref}
                  class={[
                    "w-full rounded border px-2 py-1 text-left",
                    ref in @affected && "border-blue-600 bg-blue-50",
                    ref not in @affected && "border-slate-200"
                  ]}
                >
                  <span class="font-medium">
                    {entity.label}
                  </span>
                  <span class="text-slate-500">
                    · {entity.kind} · {length(entity.event_ids)} event(s)
                  </span>
                  <%= if ref in @affected do %>
                    <span class="ml-1 rounded bg-blue-700 px-1 text-[10px] uppercase text-white">
                      affected
                    </span>
                  <% end %>
                </button>
              </li>
            <% end %>
          </ul>
        </details>
      </section>
    </div>

    <%= if @show_legend do %>
      <%!-- phx-window-keydown gives Escape without a hook; the backdrop closes
      on click, and focus starts on the close button so keyboard users are not
      stranded behind the dialog. --%>
      <div
        id="atlas-legend-modal"
        class="atlas-modal"
        phx-window-keydown="hide_legend"
        phx-key="Escape"
      >
        <div
          class="atlas-modal__backdrop"
          phx-click="hide_legend"
          aria-hidden="true"
        >
        </div>
        <div
          class="atlas-modal__panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="atlas-legend-title"
        >
          <div class="atlas-modal__head">
            <h2
              id="atlas-legend-title"
              class="atlas-modal__title"
            >
              Truth states
            </h2>
            <button
              type="button"
              id="atlas-legend-close"
              phx-click="hide_legend"
              class="atlas-modal__close"
              aria-label="Close"
              phx-mounted={JS.focus()}
            >
              ✕
            </button>
          </div>

          <p class="atlas-modal__lede">
            How settled a claim is, least to most. Every event carries one.
          </p>

          <ul
            id="atlas-legend"
            class="atlas-legend"
            role="list"
          >
            <%= for state <- Atlas.truth_states() do %>
              <li class="atlas-legend__item">
                <span
                  class={["atlas-legend__glyph", truth_classes(state)]}
                  aria-hidden="true"
                >
                  {truth_glyph(state)}
                </span>
                <span>
                  <strong>{state}</strong>
                  <span class="atlas-legend__desc">— {truth_description(state)}</span>
                </span>
              </li>
            <% end %>
          </ul>

          <p class="atlas-modal__note">
            Annotations are their own events with their own author.
            They never overwrite a source event.
          </p>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
