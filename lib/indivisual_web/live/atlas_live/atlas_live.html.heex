<%!-- NOTE: the interior of this template still carries the Tailwind utility
classes it was written with in adaptics. The surrounding chrome now follows the
Swiss/minimal system in assets/css/app.css; converting the remaining ~140 class
attributes is a separate pass, tracked in PLAN.md. It is deliberately NOT done
inline here — the page works, and a blind find-and-replace across 1073 lines
would be a good way to break it silently. --%>
<Layouts.app
  flash={@flash}
  current_scope={assigns[:current_scope]}
  full={true}
>
  <div
    id="atlas"
    class="atlas"
  >
    <header class="border-b border-slate-200 bg-white px-4 py-3 sm:px-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <h1 class="text-xl font-semibold tracking-tight">
            Shared models of reality, read from an append-only event stream.
          </h1>
        </div>
        <dl
          id="atlas-status"
          class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600"
          aria-live="polite"
        >
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Data:
            </dt>
            <dd>
              <span class="rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 font-medium text-amber-800">
                Demo fixture
              </span>
              No live blockchain or external API is connected.
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Feed:
            </dt>
            <dd id="atlas-live-status">
              <%= if @live? do %>
                live · {@live_updates} update(s) since load
              <% else %>
                connecting…
              <% end %>
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Persistence:
            </dt>
            <dd id="atlas-persistence-status">
              <%= case @feed_status.persistence do %>
                <% :ok -> %>
                  Postgres · {@feed_status.persisted_count} appended event(s) kept across restarts
                <% {:error, _reason} -> %>
                  <span class="rounded border border-red-300 bg-red-50 px-1.5 py-0.5 font-medium text-red-800">
                    unavailable
                  </span>
                  Appends are refused until the store is reachable.
              <% end %>
            </dd>
          </div>
          <div class="flex items-center gap-1">
            <dt class="font-medium">
              Events:
            </dt>
            <dd id="atlas-event-count">
              {length(@events)}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <%!-- ============ Projection selector ============ --%>
    <%!-- The projection row, timeline, and scrubber are the controls; the columns
    below are what they control. They stick to the top so a reader deep in the
    graph or map can still change the range without scrolling back up — see
    `.atlas-controls` for when sticking is withheld. --%>
    <div
      id="atlas-controls"
      class="atlas-controls"
    >
      <%!-- Four mutually exclusive options, so a radio group: the browser gives
    arrow-key navigation and a single-selection contract for free, and all four
    stay visible rather than hiding behind a menu. --%>
      <nav
        id="atlas-projection-nav"
        class="atlas-projnav"
        aria-label="Projection"
      >
        <form
          id="atlas-projections"
          phx-change="select_projection"
          class="atlas-projnav__row"
          role="radiogroup"
          aria-label="Projection"
        >
          <%= for def <- @projections do %>
            <label class={["atlas-projnav__option", def.id == @projection && "is-active"]}>
              <input
                type="radio"
                name="projection"
                value={def.id}
                checked={def.id == @projection}
                class="sr-only"
              />
              <span class="atlas-projnav__name">
                {def.name}
              </span>
              <span class="atlas-projnav__question">
                {def.question}
              </span>
            </label>
          <% end %>
        </form>
      </nav>

      <%!-- The full-width source row that sat here is unmounted, not deleted: it
    lives on as `IndivisualWeb.AtlasComponents.source_nav/1`. The source filter
    is now the checklist on the activity list, beside the thing it filters. --%>

      <%!-- ============ Timeline: full-width, above the columns ============ --%>
      <%!-- Its own element at 100% width, holding exactly two controls: an "all
    events" toggle, and one range bar with two handles. Either bound may be left open,
    so the range reads "from the beginning" or "to the present" rather than
    forcing a window. --%>
      <section
        id="atlas-timeline"
        class="atlas-timeline"
        aria-label="Timeline"
      >
        <AtlasComponents.accordion
          id="atlas-timeline-panel"
          title="Timeline"
          open?={@timeline_open?}
          toggle="toggle_timeline"
          toggle_id="atlas-timeline-collapse"
          body_id="atlas-timeline-body"
        >
          <:head>
            <label
              id="atlas-timeline-all"
              class="atlas-timeline__toggle"
            >
              <input
                type="checkbox"
                phx-click="toggle_all"
                checked={@show_all}
                aria-describedby="atlas-timeline-readout"
              />
              <span>All events</span>
            </label>

            <%!-- One readout for the whole band: how much of the record is in view,
          over what range, and where the reader stands in it. It lives in the
          header, so it still reads when either panel is folded. --%>
            <p
              id="atlas-timeline-readout"
              class="atlas-timeline__readout"
            >
              <%= if @all_events == [] do %>
                No events.
              <% else %>
                Showing {length(@events)} of {length(@all_events)} ·
                <%= if @range_from || @range_to do %>
                  {if @range_outside?, do: "outside "}{range_label(
                    @all_events,
                    @range_from,
                    @range_to
                  )}
                <% else %>
                  full range
                <% end %>
                <span id="atlas-timeline-position">
                  <%= if @selected do %>
                    · event {(@selected_index || 0) + 1} · {date(Event.effective_time(@selected))}
                  <% else %>
                    · no events match the current filter
                  <% end %>
                </span>
              <% end %>
            </p>

            <div class="atlas-timeline__actions">
              <button
                type="button"
                phx-click="step"
                phx-value-dir="prev"
                aria-label="Previous event"
              >
                ← Prev
              </button>
              <button
                type="button"
                phx-click="step"
                phx-value-dir="next"
                aria-label="Next event"
              >
                Next →
              </button>
              <%= if @range_from || @range_to do %>
                <button
                  type="button"
                  phx-click="clear_range"
                  id="atlas-timeline-clear"
                >
                  Clear range
                </button>
              <% end %>
            </div>
          </:head>

          <%!-- Not merely hidden: a collapsed band should not ship 16 mark
          buttons and two range inputs the reader cannot see. --%>
          <%= if @timeline_open? do %>
            <%!-- One bar, two handles. The two native range inputs share a
            single track (CSS overlays them; only the thumbs take pointer
            events), so it stays keyboard-accessible with no hook. A handle
            resting on an end of the bar is an OPEN bound — "from the start" /
            "to the present" — so relaxing a constraint is just letting go of
            it at the edge. The mode switch reads the same window from either
            side: what happened in it, or what happened outside it. --%>
            <div
              id="atlas-timeline-rangebar"
              class={["atlas-range", @show_all && "is-disabled"]}
            >
              <form
                phx-change="range"
                id="atlas-timeline-range"
                class={["atlas-range__bar", @range_outside? && "is-outside"]}
                style={"--from: #{range_fraction(@all_events, @range_from, :start)}; --to: #{range_fraction(@all_events, @range_to, :end)}"}
              >
                <span
                  class="atlas-range__track"
                  aria-hidden="true"
                ></span>
                <%!-- One dot per activity, on the handles' own (ordinal) axis, so
                a handle lands exactly on a dot. Display only: picking an event
                is the Position slider's job, and the dots do not compete with
                it. Past the bar's capacity, runs of events pack into one dot
                that carries its count. When the bar is fanned out by source the
                dots move down into their lanes, so each activity is drawn once
                in either state. --%>
                <%= unless @lanes? do %>
                  <AtlasComponents.range_dots
                    id="atlas-timeline-dots"
                    dots={@range_dots.all}
                  />
                <% end %>
                <label
                  for="atlas-timeline-from"
                  class="sr-only"
                >
                  Range start
                </label>
                <input
                  id="atlas-timeline-from"
                  type="range"
                  name="from"
                  min="0"
                  max={max(length(@all_events) - 1, 0)}
                  value={@range_from || 0}
                  disabled={@show_all}
                  aria-valuetext={
                    if(@range_from,
                      do: index_label(@all_events, @range_from),
                      else: "from the start"
                    )
                  }
                />
                <label
                  for="atlas-timeline-to"
                  class="sr-only"
                >
                  Range end
                </label>
                <input
                  id="atlas-timeline-to"
                  type="range"
                  name="to"
                  min="0"
                  max={max(length(@all_events) - 1, 0)}
                  value={@range_to || max(length(@all_events) - 1, 0)}
                  disabled={@show_all}
                  aria-valuetext={
                    if(@range_to, do: index_label(@all_events, @range_to), else: "to the present")
                  }
                />
              </form>

              <%!-- The accordion: one bar holding every activity, or that same
              bar fanned out into one lane per source. Lanes share the bar's
              axis and its packing, so a lane's dot sits directly under the
              place it came out of and the lanes sum back to the single bar. --%>
              <button
                type="button"
                id="atlas-timeline-lanes-toggle"
                phx-click="toggle_lanes"
                class="atlas-range__fan"
                aria-expanded={to_string(@lanes?)}
                aria-controls="atlas-timeline-lanes"
                disabled={@show_all}
                title={
                  if(@lanes?,
                    do: "Collapse into one bar",
                    else: "Fan out into one bar per source"
                  )
                }
              >
                <span aria-hidden="true">
                  <%= if @lanes? do %>
                    ▾
                  <% else %>
                    ▸
                  <% end %>
                </span>
                By source
              </button>

              <div
                id="atlas-timeline-mode"
                class="atlas-range__mode"
                role="radiogroup"
                aria-label="Show events in or out of the range"
              >
                <button
                  type="button"
                  id="atlas-timeline-mode-in"
                  role="radio"
                  phx-click="range_mode"
                  phx-value-mode="in"
                  aria-checked={to_string(not @range_outside?)}
                  disabled={@show_all || !(@range_from || @range_to)}
                >
                  In range
                </button>
                <button
                  type="button"
                  id="atlas-timeline-mode-out"
                  role="radio"
                  phx-click="range_mode"
                  phx-value-mode="out"
                  aria-checked={to_string(@range_outside?)}
                  disabled={@show_all || !(@range_from || @range_to)}
                  title={
                    if(@range_from || @range_to,
                      do: "Show what happened outside this window",
                      else: "Set a range first — with no window there is no outside."
                    )
                  }
                >
                  Out of range
                </button>
              </div>

              <%= if @lanes? do %>
                <ol
                  id="atlas-timeline-lanes"
                  class="atlas-range__lanes"
                  aria-label="Activities by source"
                >
                  <%= for {id, source} <- Enum.sort_by(@sources, fn {_, s} -> s.title end), id in @shown_sources do %>
                    <li
                      id={"atlas-timeline-lane-#{id}"}
                      class="atlas-range__lane"
                    >
                      <span class="atlas-range__lane-label">
                        {source.title}
                        <span class="atlas-range__lane-n">
                          {@range_dots.lanes
                          |> Map.get(id, [])
                          |> Enum.map(& &1.count)
                          |> Enum.sum()}
                        </span>
                      </span>
                      <span class="atlas-range__lane-line">
                        <AtlasComponents.range_dots dots={Map.get(@range_dots.lanes, id, [])} />
                      </span>
                    </li>
                  <% end %>
                </ol>
              <% end %>
            </div>

            <%!-- Marks: real time horizontally, simultaneity stacked vertically.
      No horizontal scale separates 12 events that share a timestamp, so the
      band stops trying and stacks them instead. --%>
            <%= if @timeline.marks != [] do %>
              <div
                id="atlas-timeline-marks"
                class="atlas-marks"
                style={"--lanes: #{@timeline.lanes}"}
                aria-label="Events positioned by time"
              >
                <%= for tick <- timeline_ticks(@timeline) do %>
                  <span
                    class="atlas-marks__tick"
                    style={"left: #{tick.x}%"}
                    aria-hidden="true"
                  >
                    <span class="atlas-marks__tick-label">{tick.label}</span>
                  </span>
                <% end %>

                <%= for mark <- @timeline.marks do %>
                  <button
                    type="button"
                    phx-click="select_event"
                    phx-value-id={mark.event_id}
                    class={[
                      "atlas-marks__mark",
                      truth_classes(mark.event.truth_state),
                      @selected && mark.event_id == @selected.event_id && "is-selected"
                    ]}
                    style={"left: #{mark.x}%; --lane: #{mark.lane}"}
                    title={"#{date(mark.time)} · #{Event.title(mark.event)}"}
                    aria-label={"#{date(mark.time)}: #{Event.title(mark.event)}"}
                  ></button>
                <% end %>

                <%= if @timeline.overflow > 0 do %>
                  <p class="atlas-marks__overflow">
                    +{@timeline.overflow} more at these times
                  </p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </AtlasComponents.accordion>

        <%!-- The Position panel (a scrubber over the selected range) sat here.
        It is unmounted, not deleted: `AtlasComponents.position_scrubber/1`.
        Position is still set from the activity list, the marks band, and
        Prev / Next, and still read from the one readout above. --%>
      </section>
    </div>

    <div class="grid gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[17rem_22rem_minmax(0,1fr)] lg:items-start">
      <%!-- ============ Column 1: the event log ============ --%>
      <%!-- space-y-6 would put 1.5rem above the heading via its first child;
      the column holds one block now, so it needs no vertical rhythm of its
      own. --%>
      <div>
        <div>
          <div class="atlas-activity__head">
            <h2 class="text-sm font-semibold">
              Activity
            </h2>
            <%!-- A density control, not a view switch. It was labelled "show
            on timeline", which claimed a relationship to the marks band above
            that does not exist: the band is always shown, and this only sets
            how much each row says. --%>
            <button
              type="button"
              id="atlas-activity-toggle"
              phx-click="toggle_density"
              class="atlas-term"
              aria-pressed={to_string(@dense?)}
              title={
                if @dense?,
                  do: "Show source and affected count on each row",
                  else: "Show titles and dates only"
              }
            >
              <%= if @dense? do %>
                more detail
              <% else %>
                less detail
              <% end %>
            </button>
          </div>

          <%!-- The source filter decides what this list queries, so a compact
          copy of it sits on the list itself. The full row above says what each
          source IS; this one only says which are feeding the list right now.
          Checked means included, so "all checked" and "no filter" are the same
          state, and the last checked source cannot be unchecked — an empty
          list would read as "nothing happened" rather than "nothing selected". --%>
          <div
            id="atlas-activity-sources"
            class="atlas-srcfilter"
            role="group"
            aria-labelledby="atlas-activity-sources-label"
          >
            <p class="atlas-srcfilter__head">
              <span id="atlas-activity-sources-label">
                Sources
              </span>
              <span
                id="atlas-activity-sources-count"
                class="atlas-srcfilter__count"
              >
                {length(@shown_sources)} of {map_size(@sources)}
              </span>
              <%= if @source_filter != [] do %>
                <button
                  type="button"
                  id="atlas-activity-sources-all"
                  phx-click="clear_sources"
                  class="atlas-sourcenav__clear"
                >
                  all
                </button>
              <% end %>
            </p>
            <%= for {id, source} <- Enum.sort_by(@sources, fn {_, s} -> s.title end) do %>
              <button
                type="button"
                id={"atlas-activity-source-#{id}"}
                role="checkbox"
                phx-click="check_source"
                phx-value-source={id}
                aria-checked={to_string(id in @shown_sources)}
                aria-disabled={to_string(@shown_sources == [id])}
                title={
                  if(@shown_sources == [id],
                    do: "At least one source stays on.",
                    else: source.title
                  )
                }
                class="atlas-srcfilter__item"
              >
                <span
                  class="atlas-srcfilter__box"
                  aria-hidden="true"
                ></span>
                <span class="atlas-srcfilter__title">
                  {source.title}
                </span>
                <span class="atlas-srcfilter__n">
                  {Map.get(@source_counts, id, 0)}
                </span>
              </button>
            <% end %>
          </div>

          <%!-- Reference material, not a control — so it sits beside the thing
          it explains. Every row below carries a truth-state chip; this is the
          key to those chips, not a filter on the page. --%>
          <p class="atlas-activity__key">
            <button
              type="button"
              id="atlas-legend-open"
              phx-click="show_legend"
              class="atlas-legend-button"
              aria-haspopup="dialog"
            >
              <span aria-hidden="true">ⓘ</span> Truth states
            </button>
          </p>

          <ol
            id="atlas-activity"
            class={["space-y-1", @dense? && "atlas-activity--compact"]}
            aria-label="Activity, in source order"
          >
            <%= for {event, i} <- Enum.with_index(@events) do %>
              <li
                id={"atlas-activity-#{i}"}
                data-source={event.source_id}
              >
                <button
                  type="button"
                  phx-click="select_event"
                  phx-value-id={event.event_id}
                  aria-current={
                    if @selected && event.event_id == @selected.event_id, do: "true", else: nil
                  }
                  class={[
                    "atlas-activity__item",
                    @selected && event.event_id == @selected.event_id && "is-selected",
                    @selected_index && i > @selected_index && "is-future"
                  ]}
                >
                  <span class="flex items-center justify-between gap-2">
                    <time
                      datetime={stamp(Event.effective_time(event))}
                      class="font-mono text-[11px] text-slate-500"
                    >
                      {date(Event.effective_time(event))}
                    </time>
                    <span class={[
                      "inline-flex items-center gap-1 rounded border px-1 text-[10px]",
                      truth_classes(event.truth_state)
                    ]}>
                      <span aria-hidden="true">
                        {truth_glyph(event.truth_state)}
                      </span>
                      {event.truth_state}
                    </span>
                  </span>
                  <span class="mt-0.5 block font-medium text-slate-900">
                    <%= if Event.annotation?(event) do %>
                      <span class="rounded border border-slate-300 px-1 text-[10px] uppercase">
                        annotation
                      </span>
                    <% end %>
                    {Event.title(event)}
                  </span>
                  <span class="block text-slate-500">
                    {source_title(@sources, event.source_id)} · affects {length(
                      Event.affected_refs(event)
                    )}
                  </span>
                </button>
              </li>
            <% end %>
          </ol>
        </div>
      </div>

      <%!-- ============ Column 2: entity / selected-event detail ============ --%>
      <section
        id="atlas-reader"
        class="space-y-4"
        aria-label="Context reader"
      >
        <%= if @selected do %>
          <article
            id="atlas-selected"
            class="atlas-record"
            aria-live="polite"
          >
            <%!-- The type is a typed reference, not a label: showing its
            segments makes the namespacing legible instead of leaving one
            opaque dotted string. --%>
            <p class="atlas-record__type">
              <%= if Event.annotation?(@selected) do %>
                <span class="atlas-record__kind is-annotation">annotation</span>
              <% else %>
                <span class="atlas-record__kind">event</span>
              <% end %>
              <span class="atlas-ref">
                <%= for {seg, i} <- Enum.with_index(String.split(@selected.event_type, ".")) do %>
                  <%= if i > 0 do %>
                    <span
                      class="atlas-ref__sep"
                      aria-hidden="true"
                    >/</span>
                  <% end %>
                  <span class="atlas-ref__seg">{seg}</span>
                <% end %>
              </span>
            </p>
            <h2
              id="atlas-selected-title"
              class="atlas-record__title"
            >
              {Event.title(@selected)}
            </h2>
            <%= if @selected.payload["summary"] do %>
              <p class="mt-1 text-sm text-slate-700">
                {@selected.payload["summary"]}
              </p>
            <% end %>
            <%= if @selected.payload["body"] do %>
              <p class="mt-1 text-sm text-slate-700">
                {@selected.payload["body"]}
              </p>
            <% end %>

            <dl class="atlas-fields">
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="truth_state"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Truth state
                </button>
              </dt>
              <dd id="atlas-selected-truth">
                <span class={[
                  "inline-flex items-center gap-1 rounded border px-1.5",
                  truth_classes(@selected.truth_state)
                ]}>
                  <span aria-hidden="true">
                    {truth_glyph(@selected.truth_state)}
                  </span>
                  {@selected.truth_state}
                </span>
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="occurred"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Occurred
                </button>
              </dt>
              <dd>
                {stamp(@selected.occurred_at)}
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="observed"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Observed
                </button>
              </dt>
              <dd>
                {stamp(@selected.observed_at)}
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="source"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Source
                </button>
              </dt>
              <dd id="atlas-selected-source">
                <%= if url = source_url(@sources, @selected.source_id) do %>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener"
                    class="text-blue-700 underline underline-offset-2"
                  >
                    {source_title(@sources, @selected.source_id)}
                  </a>
                <% else %>
                  {source_title(@sources, @selected.source_id)}
                <% end %>
                <span class="ml-1 rounded border border-slate-300 px-1 text-[11px] text-slate-600">
                  {source_status(@sources, @selected.source_id)}
                </span>
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="stream"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Stream
                </button>
              </dt>
              <dd>
                {@selected.stream_id} · seq {sequence(@selected.sequence)}
              </dd>
              <%= if @selected.actor do %>
                <dt class="text-slate-500">
                  Actor
                </dt>
                <dd>
                  <button
                    type="button"
                    phx-click="focus_entity"
                    phx-value-ref={@selected.actor}
                    class="text-blue-700 underline underline-offset-2"
                  >
                    {entity_label(@read_model, @selected.actor)}
                  </button>
                </dd>
              <% end %>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="affects"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Affects
                </button>
              </dt>
              <dd id="atlas-selected-affects">
                <ul
                  class="flex flex-wrap gap-1"
                  role="list"
                >
                  <%= for ref <- @selected.object do %>
                    <li>
                      <%!-- An affected entity is a linked object: its kind
                      carries a schema.org type, so a reader (or a consumer)
                      knows what sort of thing it is, not just its name. --%>
                      <button
                        type="button"
                        phx-click="focus_entity"
                        phx-value-ref={ref}
                        class="atlas-entity"
                        title={entity_title(@read_model, ref)}
                      >
                        <span class="atlas-entity__name">{entity_label(@read_model, ref)}</span>
                        <%= if type = entity_schema_type(@read_model, ref) do %>
                          <span class="atlas-entity__type">{type}</span>
                        <% end %>
                      </button>
                    </li>
                  <% end %>
                </ul>
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="provenance"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Provenance
                </button>
              </dt>
              <dd id="atlas-selected-provenance">
                <ul
                  class="atlas-prov"
                  role="list"
                >
                  <%= for {k, v} <- provenance_order(@selected.provenance) do %>
                    <li class="atlas-prov__row">
                      <span class="atlas-prov__key">{k}</span>
                      <%= cond do %>
                        <% link?(v) -> %>
                          <a
                            href={v}
                            target="_blank"
                            rel="noopener"
                            class="atlas-prov__link"
                            title={v}
                          >
                            {URI.parse(v).host}<span class="atlas-prov__path">{URI.parse(v).path}</span>
                          </a>
                        <% digest_key?(k) -> %>
                          <%!-- An opaque digest: what a reader compares is the
                          head and tail, and the whole value stays available. --%>
                          <code
                            class="atlas-prov__digest"
                            title={to_string(v)}
                          >{abbrev(to_string(v))}</code>
                        <% true -> %>
                          <span class="atlas-prov__value">{to_string(v)}</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </dd>
              <dt class="text-slate-500">
                <button
                  type="button"
                  phx-click="explain"
                  phx-value-term="event_id"
                  class="atlas-term"
                  aria-haspopup="dialog"
                  title="What does this mean?"
                >
                  Event id
                </button>
              </dt>
              <dd id="atlas-selected-id">
                <%!-- Already a typed reference — scheme, stream, kind, name.
                Showing the segments makes that structure visible. --%>
                <span
                  class="atlas-ref atlas-ref--id"
                  title={@selected.event_id}
                >
                  <%= for {seg, i} <- Enum.with_index(id_segments(@selected.event_id)) do %>
                    <%= if i > 0 do %>
                      <span
                        class="atlas-ref__sep"
                        aria-hidden="true"
                      >:</span>
                    <% end %>
                    <span class="atlas-ref__seg">{seg}</span>
                  <% end %>
                </span>
              </dd>
            </dl>

            <%= if @selected_relationships != [] or @entity_relationships != [] do %>
              <h3 class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                Relationships
              </h3>
              <ul
                id="atlas-selected-relationships"
                class="mt-1 space-y-1 text-xs"
                role="list"
              >
                <%= for rel <- Enum.uniq(@selected_relationships ++ @entity_relationships) do %>
                  <li class={[
                    "rounded border px-2 py-1",
                    rel.event_id == @selected.event_id && "border-blue-600 bg-blue-50",
                    rel.event_id != @selected.event_id && "border-slate-200"
                  ]}>
                    <strong>{entity_label(@read_model, rel.subject)}</strong>
                    <em>{rel.relationship}</em>
                    <strong>{entity_label(@read_model, rel.object)}</strong>
                    <span class={[
                      "ml-1 inline-flex items-center gap-1 rounded border px-1",
                      truth_classes(rel.truth_state)
                    ]}>
                      <span aria-hidden="true">
                        {truth_glyph(rel.truth_state)}
                      </span>
                      {rel.truth_state}
                    </span>
                    <span class="text-slate-500">
                      · {source_title(@sources, rel.source_id)} · {date(rel.occurred_at)}
                    </span>
                    <%= if rel.event_id != @selected.event_id do %>
                      <button
                        type="button"
                        phx-click="select_event"
                        phx-value-id={rel.event_id}
                        class="ml-1 text-blue-700 underline underline-offset-2"
                      >
                        open
                      </button>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <%!-- The field labels above explain their own vocabulary; this
            answers the different question of what THIS record means. It sits
            after the record and directly above annotation: read the fields,
            ask what they add up to, then respond. --%>
            <%= if @explain_available? do %>
              <div class="atlas-explain">
                <%= case @explain_event do %>
                  <% {_id, :loading} -> %>
                    <%!-- A skeleton rather than a spinner: it occupies the
                    space the answer will fill, so the card does not jump when
                    text arrives, and the shimmer shows work is still moving.
                    Generation was measured at roughly 3-8 seconds. --%>
                    <div
                      id="atlas-explain-loading"
                      class="atlas-explain__loading"
                      role="status"
                      aria-live="polite"
                      aria-busy="true"
                    >
                      <span class="sr-only">Reading the record…</span>
                      <span
                        class="atlas-explain__skeleton"
                        aria-hidden="true"
                      ></span>
                      <span
                        class="atlas-explain__skeleton"
                        aria-hidden="true"
                      ></span>
                      <span
                        class="atlas-explain__skeleton is-short"
                        aria-hidden="true"
                      ></span>
                      <p class="atlas-explain__loading-note">
                        Reading the record
                        <button
                          type="button"
                          phx-click="hide_explain_event"
                          class="atlas-term"
                        >
                          Cancel
                        </button>
                      </p>
                    </div>
                  <% {_id, text} -> %>
                    <div
                      id="atlas-explain-result"
                      class="atlas-explain__result"
                      aria-live="polite"
                    >
                      <p class="atlas-explain__text">{text}</p>
                      <p class="atlas-explain__caveat">
                        Written by a language model from the record above. It can be wrong —
                        the record is the source, not this.
                        <button
                          type="button"
                          phx-click="hide_explain_event"
                          class="atlas-term"
                        >
                          Hide
                        </button>
                      </p>
                    </div>
                  <% _ -> %>
                    <button
                      type="button"
                      id="atlas-explain-event"
                      phx-click="explain_event"
                      class="atlas-explain__button"
                      phx-disable-with="Reading…"
                    >
                      Explain this record
                    </button>
                <% end %>

                <%= if @explain_error do %>
                  <p
                    class="atlas-explain__status"
                    role="alert"
                  >
                    {@explain_error}
                  </p>
                <% end %>
              </div>
            <% end %>

            <%= if @annotations_for_selected != [] do %>
              <h3 class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                Annotations on this event
              </h3>
              <ul
                id="atlas-selected-annotations"
                class="mt-1 space-y-1 text-xs"
                role="list"
              >
                <%= for note <- @annotations_for_selected do %>
                  <li class="rounded border border-slate-200 px-2 py-1">
                    <span class="rounded border border-slate-300 px-1">
                      {note.payload["kind"]}
                    </span>
                    {note.payload["body"]}
                    <span class="text-slate-500">
                      · {note.provenance["author"]} · {stamp(note.observed_at)}
                    </span>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <%= unless Event.annotation?(@selected) do %>
              <.form
                for={@annotation_form}
                id="atlas-annotation-form"
                phx-change="validate_annotation"
                phx-submit="annotate"
                class="mt-3 space-y-2 border-t border-slate-200 pt-3"
              >
                <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                  Annotate
                </h3>
                <%= for {field, message} <- @annotation_errors do %>
                  <p
                    class="text-xs text-red-700"
                    role="alert"
                  >
                    {field} {message}
                  </p>
                <% end %>
                <div class="grid grid-cols-2 gap-2">
                  <label class="text-xs">
                    Kind
                    <select
                      name={@annotation_form[:kind].name}
                      class="mt-0.5 w-full rounded border-slate-300 text-xs"
                    >
                      <%= for kind <- annotation_kinds() do %>
                        <option
                          value={kind}
                          selected={@annotation_form[:kind].value == kind}
                        >
                          {kind}
                        </option>
                      <% end %>
                    </select>
                  </label>
                  <label class="text-xs">
                    Author
                    <input
                      type="text"
                      name={@annotation_form[:author].name}
                      value={@annotation_form[:author].value}
                      placeholder="your name or handle"
                      class="mt-0.5 w-full rounded border-slate-300 text-xs"
                    />
                  </label>
                </div>
                <label class="block text-xs">
                  Note <textarea
                    name={@annotation_form[:body].name}
                    rows="2"
                    placeholder="Specific and checkable: what did you observe, question, or correct?"
                    class="mt-0.5 w-full rounded border-slate-300 text-xs"
                  >{@annotation_form[:body].value}</textarea>
                </label>
                <button
                  type="submit"
                  class="rounded bg-slate-900 px-3 py-1 text-xs font-medium text-white"
                >
                  Record annotation
                </button>
                <p class="text-[11px] text-slate-500">
                  Recorded as a separate event in this session's in-memory feed with your name as author.
                </p>
              </.form>
            <% end %>

            <%!-- Share is its own element, not a line of link text. What a
            person wants to know before sending it is WHAT the link reproduces;
            the URL itself is long and percent-encoded, so it is carried rather
            than displayed in full. --%>
            <aside
              id="atlas-share"
              class="atlas-share"
              aria-label="Share this view"
            >
              <div class="atlas-share__head">
                <h3 class="atlas-share__title">Share this view</h3>
                <button
                  type="button"
                  id="atlas-share-copy"
                  class="atlas-share__copy"
                  phx-hook=".CopyLink"
                  data-url={share_url(@share_path)}
                >
                  <span class="atlas-share__copy-label">Copy link</span>
                </button>
              </div>

              <p class="atlas-share__summary">
                Reproduces: {share_summary(assigns)}
              </p>

              <%!-- The address stays visible and selectable for anyone who
              would rather take it by hand. --%>
              <.link
                id="atlas-share-link"
                patch={@share_path}
                class="atlas-share__url"
                title={share_url(@share_path)}
              >
                {@share_path}
              </.link>
            </aside>

            <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyLink">
              export default {
                mounted() {
                  const label = this.el.querySelector(".atlas-share__copy-label")
                  const original = label.textContent

                  this.el.addEventListener("click", async () => {
                    const url = this.el.dataset.url
                    let ok = false

                    try {
                      // Only available on a secure origin; the fallback below
                      // covers plain http in local development.
                      await navigator.clipboard.writeText(url)
                      ok = true
                    } catch {
                      const field = document.createElement("textarea")
                      field.value = url
                      field.setAttribute("readonly", "")
                      field.style.position = "fixed"
                      field.style.opacity = "0"
                      document.body.appendChild(field)
                      field.select()
                      try { ok = document.execCommand("copy") } catch { ok = false }
                      document.body.removeChild(field)
                    }

                    label.textContent = ok ? "Copied" : "Press \u2318C to copy"
                    this.el.classList.toggle("is-copied", ok)

                    clearTimeout(this.resetTimer)
                    this.resetTimer = setTimeout(() => {
                      label.textContent = original
                      this.el.classList.remove("is-copied")
                    }, 2000)
                  })
                },

                destroyed() {
                  clearTimeout(this.resetTimer)
                }
              }
            </script>
          </article>
        <% end %>
      </section>

      <%!-- ============ Column 3: the canvas, filling remaining width ============ --%>
      <section
        id="atlas-canvas"
        class="lg:sticky lg:top-4"
        aria-labelledby="atlas-canvas-title"
      >
        <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
          <h2
            id="atlas-canvas-title"
            class="text-sm font-semibold"
          >
            {Projections.get(@projection).name}
            <span class="font-normal text-slate-500">
              · {map_size(@read_model.entities)} entities · {length(@read_model.relationships)} relationships
            </span>
          </h2>
        </div>

        <%!-- A real map: Leaflet over OpenStreetMap tiles, so a pin sits on
        actual ground rather than in an abstract plane. The hook owns the map
        DOM, so the container is phx-update="ignore" and points are handed over
        as data rather than re-rendered. --%>
        <%= if @geo.count > 0 do %>
          <div
            id="atlas-map-wrap"
            class="atlas-map"
          >
            <div
              id="atlas-map"
              class="atlas-map__canvas"
              phx-hook=".LeafletMap"
              phx-update="ignore"
              data-points={Jason.encode!(map_points(@geo, @entity, @affected))}
              aria-label="Map of entities with known locations"
            >
            </div>
          </div>

          <p class="atlas-map__caption">
            {@geo.count} of {@geo.count + @geo.unlocated_count} entities have a known location.
            <%= if @geo.unlocated_count > 0 do %>
              <span class="atlas-map__missing">
                {@geo.unlocated_count} not shown.
              </span>
            <% end %>
          </p>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".LeafletMap">
            // `@` is aliased to assets/ in the esbuild config; a relative path would
            // resolve from _build, where colocated hooks are extracted.
            import L from "@/vendor/leaflet/leaflet.js"

            export default {
              mounted() {
                this.render()
              },

              updated() {
                this.render()
              },

              render() {
                const points = JSON.parse(this.el.dataset.points || "[]")
                if (points.length === 0) return

                if (!this.map) {
                  this.map = L.map(this.el, { scrollWheelZoom: false, attributionControl: true })

                  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                  }).addTo(this.map)

                  this.layer = L.layerGroup().addTo(this.map)
                }

                this.layer.clearLayers()

                const bounds = []

                points.forEach((p) => {
                  const classes = ["atlas-pin"]
                  if (p.focused) classes.push("is-focused")
                  if (p.affected) classes.push("is-affected")

                  const marker = L.marker([p.lat, p.lng], {
                    title: p.label,
                    icon: L.divIcon({
                      className: classes.join(" "),
                      html: `<span class="atlas-pin__dot"></span><span class="atlas-pin__label">${p.label}</span>`,
                      iconSize: null
                    })
                  })

                  marker.on("click", () => this.pushEvent("focus_entity", { ref: p.ref }))
                  marker.addTo(this.layer)
                  bounds.push([p.lat, p.lng])
                })

                // Fit once; refitting on every update would yank the view out
                // from under someone who has panned.
                if (!this.fitted) {
                  this.map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 })
                  this.fitted = true
                }
              },

              destroyed() {
                if (this.map) { this.map.remove(); this.map = null }
              }
            }
          </script>
        <% end %>

        <%= if @projection == "provenance" do %>
          <ul
            id="atlas-provenance-counts"
            class="mb-2 flex flex-wrap gap-2 text-xs"
            role="list"
          >
            <%= for %{truth_state: state, events: es} <- @read_model.groups do %>
              <li class={["rounded border px-2 py-0.5", truth_classes(state)]}>
                <span aria-hidden="true">
                  {truth_glyph(state)}
                </span>
                {state}: {length(es)}
              </li>
            <% end %>
          </ul>
        <% end %>

        <p class="sr-only">
          The canvas draws {map_size(@read_model.entities)} entities on a ring and {length(
            @read_model.relationships
          )} relationships between them.
          The same information is available as lists in the reader.
        </p>

        <%!-- The column itself is unframed; each instrument in it carries its
        own border, so the map and the graph read as two things, not one box. --%>
        <div
          id="atlas-graph"
          class="atlas-graph"
        >
          <svg
            id="atlas-svg"
            viewBox="0 0 800 600"
            class="h-auto w-full max-w-full"
            role="img"
            aria-label={"Topology of #{map_size(@read_model.entities)} entities and #{length(@read_model.relationships)} relationships"}
            data-projection={@projection}
            data-selected={@selected && @selected.event_id}
          >
            <g id="atlas-svg-relationships">
              <%= for rel <- @read_model.relationships do %>
                <% from = Map.get(@read_model.positions, rel.subject) %>
                <% to = Map.get(@read_model.positions, rel.object) %>
                <%= if from && to do %>
                  <line
                    x1={from.x}
                    y1={from.y}
                    x2={to.x}
                    y2={to.y}
                    stroke={truth_stroke(rel.truth_state)}
                    stroke-width={
                      if @selected && rel.event_id == @selected.event_id, do: "4", else: "1.5"
                    }
                    stroke-dasharray={
                      if rel.truth_state in ["proposed", "reported"], do: "6 4", else: nil
                    }
                    opacity={
                      if @selected && rel.event_id == @selected.event_id, do: "1", else: "0.55"
                    }
                    data-event={rel.event_id}
                    data-truth={rel.truth_state}
                    class="motion-safe:transition-all"
                  >
                    <title>
                      {entity_label(@read_model, rel.subject)} {rel.relationship} {entity_label(
                        @read_model,
                        rel.object
                      )} ({rel.truth_state})
                    </title>
                  </line>
                <% end %>
              <% end %>
            </g>
            <g id="atlas-svg-entities">
              <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
                <% pos = Map.fetch!(@read_model.positions, ref) %>
                <% affected? = ref in @affected %>
                <% focused? = ref == @entity %>
                <g
                  phx-click="focus_entity"
                  phx-value-ref={ref}
                  class="cursor-pointer"
                  data-ref={ref}
                  data-affected={to_string(affected?)}
                  role="button"
                  tabindex="-1"
                >
                  <circle
                    cx={pos.x}
                    cy={pos.y}
                    r={if affected? or focused?, do: 16, else: 10}
                    fill={if affected?, do: "#1d4ed8", else: "#ffffff"}
                    stroke={if focused?, do: "#b45309", else: "#1e293b"}
                    stroke-width={if affected? or focused?, do: "3", else: "1.5"}
                    class="motion-safe:transition-all"
                  >
                    <title>
                      {entity.label} ({entity.kind}) — {length(entity.event_ids)} event(s)
                    </title>
                  </circle>
                  <text
                    x={pos.x}
                    y={pos.y + if pos.y > 300, do: 30, else: -22}
                    text-anchor="middle"
                    font-size="12"
                    fill="#0f172a"
                    font-weight={if affected?, do: "600", else: "400"}
                  >
                    {entity.label}
                  </text>
                  <%= if affected? do %>
                    <text
                      x={pos.x}
                      y={pos.y + 4}
                      text-anchor="middle"
                      font-size="10"
                      fill="#ffffff"
                      aria-hidden="true"
                    >
                      ●
                    </text>
                  <% end %>
                </g>
              <% end %>
            </g>
          </svg>
        </div>

        <details class="mt-2 text-xs">
          <summary class="cursor-pointer text-slate-600">
            Entities in this projection ({map_size(@read_model.entities)})
          </summary>
          <ul
            id="atlas-entity-list"
            class="mt-1 grid gap-1 sm:grid-cols-2"
            role="list"
          >
            <%= for {ref, entity} <- Enum.sort_by(@read_model.entities, fn {ref, _} -> ref end) do %>
              <li>
                <button
                  type="button"
                  phx-click="focus_entity"
                  phx-value-ref={ref}
                  class={[
                    "w-full rounded border px-2 py-1 text-left",
                    ref in @affected && "border-blue-600 bg-blue-50",
                    ref not in @affected && "border-slate-200"
                  ]}
                >
                  <span class="font-medium">
                    {entity.label}
                  </span>
                  <span class="text-slate-500">
                    · {entity.kind} · {length(entity.event_ids)} event(s)
                  </span>
                  <%= if ref in @affected do %>
                    <span class="ml-1 rounded bg-blue-700 px-1 text-[10px] uppercase text-white">
                      affected
                    </span>
                  <% end %>
                </button>
              </li>
            <% end %>
          </ul>
        </details>
      </section>
    </div>

    <%= if @explain do %>
      <div
        id="atlas-explain-modal"
        class="atlas-modal"
        phx-window-keydown="hide_explain"
        phx-key="Escape"
      >
        <div
          class="atlas-modal__backdrop"
          phx-click="hide_explain"
          aria-hidden="true"
        >
        </div>

        <div
          class="atlas-modal__panel atlas-modal__panel--narrow"
          role="dialog"
          aria-modal="true"
          aria-labelledby="atlas-explain-title"
        >
          <div class="atlas-modal__head">
            <h2
              id="atlas-explain-title"
              class="atlas-modal__title"
            >
              {@explain.label}
            </h2>
            <button
              type="button"
              id="atlas-explain-close"
              phx-click="hide_explain"
              class="atlas-modal__close"
              aria-label="Close"
              phx-mounted={JS.focus()}
            >
              ✕
            </button>
          </div>

          <p class="atlas-explain__summary">
            {@explain.summary}
          </p>
          <p class="atlas-explain__why">
            <span class="atlas-explain__why-label">Why it is here:</span>
            {@explain.why}
          </p>

          <%= if @explain.slug == "truth_state" do %>
            <p class="atlas-modal__note">
              <button
                type="button"
                phx-click="show_legend"
                class="atlas-term"
              >
                See all six truth states
              </button>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if @show_legend do %>
      <%!-- phx-window-keydown gives Escape without a hook; the backdrop closes
      on click, and focus starts on the close button so keyboard users are not
      stranded behind the dialog. --%>
      <div
        id="atlas-legend-modal"
        class="atlas-modal"
        phx-window-keydown="hide_legend"
        phx-key="Escape"
      >
        <div
          class="atlas-modal__backdrop"
          phx-click="hide_legend"
          aria-hidden="true"
        >
        </div>
        <div
          class="atlas-modal__panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="atlas-legend-title"
        >
          <div class="atlas-modal__head">
            <h2
              id="atlas-legend-title"
              class="atlas-modal__title"
            >
              Truth states
            </h2>
            <button
              type="button"
              id="atlas-legend-close"
              phx-click="hide_legend"
              class="atlas-modal__close"
              aria-label="Close"
              phx-mounted={JS.focus()}
            >
              ✕
            </button>
          </div>

          <p class="atlas-modal__lede">
            How settled a claim is, least to most. Every event carries one.
          </p>

          <ul
            id="atlas-legend"
            class="atlas-legend"
            role="list"
          >
            <%= for state <- Atlas.truth_states() do %>
              <li class="atlas-legend__item">
                <span
                  class={["atlas-legend__glyph", truth_classes(state)]}
                  aria-hidden="true"
                >
                  {truth_glyph(state)}
                </span>
                <span>
                  <strong>{state}</strong>
                  <span class="atlas-legend__desc">— {truth_description(state)}</span>
                </span>
              </li>
            <% end %>
          </ul>

          <p class="atlas-modal__note">
            Annotations are their own events with their own author.
            They never overwrite a source event.
          </p>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
