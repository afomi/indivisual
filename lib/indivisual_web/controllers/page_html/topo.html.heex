<div
  id="topo"
  data-view={@view}
  data-cocktails={@cocktails_json}
  data-records={@records_json}
  data-axes={@axes_json}
  data-cities={@cities_json}
  data-models={@models_json}
  data-topics={@topics_json}
  style="width:100%;height:calc(100vh - 40px);margin-top:40px;position:relative;overflow:hidden;background:#0b1020;"
>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.renderTopo("#topo");
  });
</script>
