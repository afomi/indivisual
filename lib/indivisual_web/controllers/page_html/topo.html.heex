<Layouts.app flash={@flash} current_scope={@current_scope} full={true}>
  <div
    id="topo"
    data-view={@view}
    data-cocktails={@cocktails_json}
    data-records={@records_json}
    data-axes={@axes_json}
    data-cities={@cities_json}
    data-models={@models_json}
    data-topics={@topics_json}
    class="topo-stage"
  >
  </div>

  <script>
    window.addEventListener("DOMContentLoaded", () => {
      window.renderTopo("#topo");
    });
  </script>
</Layouts.app>
