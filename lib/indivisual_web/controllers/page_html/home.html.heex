<Layouts.app flash={@flash} current_scope={@current_scope}>
  <h1>indivisual</h1>

  <p>
    Two ways of looking at the same material.
    Topo places records in a space built from their meaning.
    Atlas runs the same records past you in time.
  </p>

  <h2>views</h2>

  <ul class="index">
    <li>
      <a href={~p"/topo"}>topo</a>
      <span class="desc">— records positioned by their scores on three semantic axes, in a rotatable volume</span>
    </li>
    <li>
      <a href={~p"/atlas"}>atlas</a>
      <span class="desc">— an event feed assembled from civic sources</span>
    </li>
  </ul>

  <h2>your files</h2>

  <p class="small">
    Sign in with GitHub and your work is committed to a repository you own.
    Not a database you rent from us.
    If this site disappears tomorrow, your files are still on GitHub, in a format you can read without us.
  </p>

  <%= if @current_scope do %>
    <p class="small muted">
      Signed in as {@current_scope.user.github_login || "your GitHub account"}.
    </p>
  <% else %>
    <p>
      <a
        href={~p"/auth/github"}
        class="button"
      >
        sign in with github
      </a>
    </p>
  <% end %>

  <hr />

  <p class="small faint">
    A focused fork of adaptics.
    Source at <a href="https://github.com/afomi/indivisual">github.com/afomi/indivisual</a>.
  </p>
</Layouts.app>
