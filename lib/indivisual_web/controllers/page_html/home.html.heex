<Layouts.app flash={@flash} current_scope={@current_scope}>
  <h1>indivisual</h1>

  <p>
    Better interfaces for The Public Record, and better tools for the people who decide.
    Atlas reads one append-only record of what happened, and shows it in time, on a map, and as a graph.
  </p>

  <h2>views</h2>

  <ul class="index">
    <li>
      <a href={~p"/atlas"}>atlas</a>
      <span class="desc">— an event feed assembled from civic sources</span>
      <span class="desc">
        (<a href={~p"/atlas/about"}>the ideas behind it</a>)
      </span>
    </li>
  </ul>

  <h2>your files</h2>

  <p class="small">
    Sign in with GitHub and your work is committed to a repository you own.
    Not a database you rent from us.
    If this site disappears tomorrow, your files are still on GitHub, in a format you can read without us.
  </p>

  <%= if @current_scope do %>
    <p class="small muted">
      Signed in as {@current_scope.user.github_login || "your GitHub account"}.
    </p>
  <% else %>
    <p>
      <a
        href={~p"/auth/github"}
        class="button"
      >
        sign in with github
      </a>
    </p>
  <% end %>
</Layouts.app>
