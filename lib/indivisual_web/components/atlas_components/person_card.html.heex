<article
  id={@id}
  class="atlas-person overflow-hidden rounded-lg border border-[var(--rule)] bg-[var(--paper)] shadow-sm"
  aria-labelledby={@title_id}
>
  <div class="flex items-start gap-3 p-3">
    <%= if @profile.image do %>
      <img
        src={@profile.image}
        alt=""
        loading="lazy"
        referrerpolicy="no-referrer"
        class="size-12 shrink-0 rounded-full border border-[var(--rule)] object-cover"
      />
    <% else %>
      <span
        class="grid size-12 shrink-0 place-items-center rounded-full border border-[var(--rule)] bg-[color-mix(in_srgb,var(--link)_10%,transparent)] text-sm font-bold tracking-wide text-[var(--link)]"
        aria-hidden="true"
      >
        {@profile.initials}
      </span>
    <% end %>

    <div class="min-w-0 flex-1">
      <h2
        id={@title_id}
        class="truncate text-[15px] font-bold leading-tight text-[var(--ink)]"
        title={@profile.name}
      >
        {@profile.name}
      </h2>
      <div class="mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-[11px] text-[var(--ink-soft)]">
        <span class="inline-flex items-center gap-1 rounded border border-[var(--rule)] px-1 py-0.5 font-mono text-[10px] uppercase leading-none tracking-wider">
          <.entity_icon kind="person" /> person
        </span>
        <span
          class="truncate font-mono"
          title={@profile.ref}
        >
          {@profile.ref}
        </span>
      </div>
      <%= if @profile.job_title || @profile.affiliation do %>
        <div
          id={"#{@id}-role"}
          class="mt-1 text-xs text-[var(--ink)]"
        >
          {[@profile.job_title, @profile.affiliation]
          |> Enum.reject(&is_nil/1)
          |> Enum.join(" · ")}
        </div>
      <% end %>
    </div>
  </div>

  <%= if @profile.description do %>
    <div
      id={"#{@id}-description"}
      class="px-3 pb-3 text-xs leading-relaxed text-[var(--ink)]"
    >
      {@profile.description}
    </div>
  <% end %>

  <dl class="grid grid-cols-3 divide-x divide-[var(--rule)] border-t border-[var(--rule)] text-center">
    <div class="px-2 py-2">
      <dd
        id={"#{@id}-authored"}
        class="text-base font-bold tabular-nums leading-none text-[var(--ink)]"
      >
        {@profile.authored}
      </dd>
      <dt class="mt-1 text-[10px] uppercase leading-none tracking-wider text-[var(--ink-faint)]">
        wrote
      </dt>
    </div>
    <div class="px-2 py-2">
      <dd
        id={"#{@id}-mentioned"}
        class="text-base font-bold tabular-nums leading-none text-[var(--ink)]"
      >
        {@profile.mentioned}
      </dd>
      <dt class="mt-1 text-[10px] uppercase leading-none tracking-wider text-[var(--ink-faint)]">
        named in
      </dt>
    </div>
    <div class="px-2 py-2">
      <dd class="text-xs font-bold tabular-nums leading-none text-[var(--ink)]">
        <%= if @profile.first_seen do %>
          <time datetime={DateTime.to_iso8601(@profile.first_seen)}>
            {Calendar.strftime(@profile.first_seen, "%Y-%m-%d")}
          </time>
        <% else %>
          —
        <% end %>
      </dd>
      <dt class="mt-1 text-[10px] uppercase leading-none tracking-wider text-[var(--ink-faint)]">
        first seen
      </dt>
    </div>
  </dl>

  <%= if @profile.wrote != [] do %>
    <ul
      id={"#{@id}-wrote"}
      class="flex flex-wrap gap-1 border-t border-[var(--rule)] px-3 py-2"
      role="list"
    >
      <%= for {kind, n} <- @profile.wrote do %>
        <li class="rounded-full border border-[var(--rule)] px-2 py-px text-[10px] text-[var(--ink-soft)]">
          {kind}
          <span class="tabular-nums text-[var(--ink-faint)]">{n}</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= if @profile.url || @profile.same_as != [] do %>
    <ul
      id={"#{@id}-links"}
      class="flex flex-wrap gap-x-3 gap-y-1 border-t border-[var(--rule)] px-3 py-2 text-[11px]"
      role="list"
    >
      <%= for link <- Enum.reject([@profile.url | @profile.same_as], &is_nil/1) do %>
        <li class="min-w-0">
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="block truncate"
            title={link}
          >
            {URI.parse(link).host}
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= if not @profile.registered? do %>
    <div
      id={"#{@id}-unregistered"}
      class="border-t border-dashed border-[var(--rule)] bg-[color-mix(in_srgb,var(--ink)_3%,transparent)] px-3 py-2 text-[11px] leading-snug text-[var(--ink-soft)]"
    >
      Not registered.
      Known only from what the record shows them doing.
    </div>
  <% end %>
</article>
