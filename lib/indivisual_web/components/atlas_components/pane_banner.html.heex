<div
  id={@id}
  class={[
    "flex items-center gap-x-6 px-6 sm:px-3.5 sm:before:flex-1",
    @tone == "dark" &&
      "bg-gray-900 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-white/10",
    @tone == "indigo" && "bg-indigo-600",
    @fixed && "fixed inset-x-0 top-0 z-50 h-11",
    !@fixed && "relative py-2.5"
  ]}
  role="status"
>
  <p
    id={@note_id}
    class="m-0 max-w-none min-w-0 truncate text-sm/6 text-white"
  >
    <strong class="font-semibold">{@title}</strong>
    <svg
      viewBox="0 0 2 2"
      aria-hidden="true"
      class="mx-2 inline size-0.5 fill-current"
    >
      <circle
        r="1"
        cx="1"
        cy="1"
      />
    </svg>
    {render_slot(@inner_block)}
  </p>
  <div class="flex flex-1 justify-end">
    {render_slot(@action)}
  </div>
</div>
