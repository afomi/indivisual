<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="csrf-token"
      content={get_csrf_token()}
    />
    <.live_title default="indivisual">{assigns[:page_title]}</.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/app.css"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/app.js"}
    >
    </script>
  </head>
  <body>
    <header class="masthead">
      <a
        href="/"
        class="masthead__name"
      >
        indivisual
      </a>
      <nav>
        <a href={~p"/topo"}>topo</a>
        <a href={~p"/atlas"}>atlas</a>
        <%= if @current_scope do %>
          <span class="faint">{@current_scope.user.github_login || "signed in"}</span>
          <a href={~p"/users/settings"}>settings</a>
          <.link
            href={~p"/users/log-out"}
            method="delete"
          >
            log out
          </.link>
        <% else %>
          <a href={~p"/auth/github"}>sign in with github</a>
        <% end %>
      </nav>
    </header>
    {@inner_content}
  </body>
</html>
