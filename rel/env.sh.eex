#!/bin/sh

# Erlang distribution for a SINGLE-INSTANCE app.
#
# The two settings below MUST agree. `sname` takes a SHORT name with NO dots —
# pairing `sname` with a dotted host (e.g. indivisual@10.0.1.5) crashes the
# release at boot with "Can't set short node name". That combination has bitten
# this fleet twice (bitblocks 2026-06-17, bitcoinsv-bot 2026-07-16).
#
# If indivisual ever scales to multiple clustered instances, switch to:
#   RELEASE_DISTRIBUTION=name
#   RELEASE_NODE=indivisual@<private_ip>
# and set RELEASE_COOKIE from the app secret — sname cannot cluster across hosts.
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE=indivisual
